{% autoescape 'html' %}
{% import templates ~ 'ui.twig' as ui %}
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <div class="brand footer-brand">
        {% if site.logo_url|default('') %}<img class="brand-logo" src="{{ site.logo_url }}" alt="{{ company }}" width="240" height="93">{% elseif company %}<strong>{{ company }}</strong>{% endif %}
      </div>
      {% if site.footer_text|default('') %}<p>{{ site.footer_text }}</p>{% endif %}
    </div>
    {% if footerNav %}
      <div>{% if site.footer_sections_title|default('') %}<strong>{{ site.footer_sections_title }}</strong>{% endif %}
        {% for item in footerNav %}{{ ui.nav(item) }}{% endfor %}
      </div>
    {% endif %}
    {% if site.footer_contacts_title|default('') or site.email|default('') or tel or site.address|default('') or site.working_hours|default('') %}
      <div>{% if site.footer_contacts_title|default('') %}<strong>{{ site.footer_contacts_title }}</strong>{% endif %}
        {% if site.email|default('') %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
        {% if tel %}<a href="{{ tel }}">{{ site.phone }}</a>{% endif %}
        {% if site.city|default('') or site.address|default('') %}<span>{{ [site.city|default(''), site.address|default('')]|filter(value => value)|join(', ') }}</span>{% endif %}
        {% if site.working_hours|default('') %}<span>{{ site.working_hours }}</span>{% endif %}
      </div>
    {% endif %}
    {% if site.footer_brand_label|default('') or site.footer_disclaimer|default('') %}
      <div class="footer-note">{% if site.footer_brand_label|default('') %}<span>{{ site.footer_brand_label }}</span>{% endif %}{% if site.footer_disclaimer|default('') %}<p>{{ site.footer_disclaimer }}</p>{% endif %}</div>
    {% endif %}
  </div>
  {% if site.sections|default([]) %}<div class="shell">{% include templates ~ 'sections.twig' with {sections: site.sections} %}</div>{% endif %}
  <div class="shell footer-bottom">
    {% if site.footer_copyright|default('') %}<span>{{ site.footer_copyright }}</span>{% elseif company %}<span>© {{ 'now'|date('Y') }} {{ company }}</span>{% endif %}
    {% if legalNav %}<div class="footer-legal">{% for item in legalNav %}{{ ui.nav(item) }}{% endfor %}</div>{% endif %}
  </div>
</footer>
{% endautoescape %}
