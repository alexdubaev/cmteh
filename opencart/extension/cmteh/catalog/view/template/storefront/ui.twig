{% macro href(value) %}{% autoescape 'html' %}{% if value matches '~^(?:/(?![/\\x5c])|https?://)[^\\x00-\\x20\\x5c]*$~i' %}{{ value }}{% endif %}{% endautoescape %}{% endmacro %}
{% macro nav(item) %}{% autoescape 'html' %}{% set href = _self.href(item.url|default('')) %}{% if href %}
<a href="{{ href }}"{% if item.open_in_new_tab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.label|default('') }}</a>
{% endif %}{% endautoescape %}{% endmacro %}
{% macro asset(id) %}{% autoescape 'html' %}{% if id matches '/^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$/' %}/api/assets/{{ id }}{% endif %}{% endautoescape %}{% endmacro %}
{% macro price(product) %}{% autoescape 'html' %}
{%- set currency = product.currency|default('')|upper -%}
{%- set symbols = {RUB: '₽', USD: '$', EUR: '€', CNY: 'CN¥', GBP: '£', KZT: '₸', JPY: '¥'} -%}
{%- if product.price_status|default('') == 'fixed' and product.price is not null and product.price >= 0 and currency matches '/^[A-Z]{3}$/' -%}
  {{- product.price|number_format(product.price == product.price|round(0) or currency in ['JPY', 'KRW'] ? 0 : (currency in ['BHD', 'KWD', 'OMR', 'JOD', 'TND'] ? 3 : 2), ',', ' ') }} {{ symbols[currency]|default(currency) -}}
{%- else -%}
  Цена по запросу
{%- endif -%}
{% endautoescape %}{% endmacro %}
{% macro status(value) %}{% autoescape 'html' %}{{ {'in_stock': 'В наличии', 'on_request': 'Под заказ', 'out_of_stock': 'Нет в наличии'}[value]|default('По запросу') }}{% endautoescape %}{% endmacro %}
{% macro part(value) %}{% autoescape 'html' %}{{ {'original': 'Оригинал', 'oem': 'OEM', 'analog': 'Аналог'}[value]|default('') }}{% endautoescape %}{% endmacro %}
{% macro noPhoto(size) %}{% autoescape 'html' %}<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="1"></rect><circle cx="8" cy="8" r="1.5"></circle><path d="m3 17 5-5 4 4 4-6 5 7"></path></svg>{% endautoescape %}{% endmacro %}
{% macro copy(article) %}{% autoescape 'html' %}
<span class="copy-article">
  <button class="copy-article-button" type="button" data-copy="{{ article }}" aria-label="Скопировать артикул {{ article }}" title="Скопировать артикул"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1"></rect><path d="M16 8V4H4v12h4"></path></svg></button>
  <span class="copy-article-feedback" role="status"></span>
</span>
{% endautoescape %}{% endmacro %}
{% macro add(product, full = false) %}{% autoescape 'html' %}
<button class="{{ full ? 'button primary wide' : 'card-action' }}" type="button" data-add-article="{{ product.sku }}" data-title="{{ product.title }}" data-brand="{{ product.brand }}">В корзину</button>
<span class="request-announcement" role="status" aria-live="polite"></span>
{% endautoescape %}{% endmacro %}
{% macro card(product) %}{% autoescape 'html' %}
{% set photo = product.main_image_url|default('') ?: _self.asset(product.main_image|default('')) %}
{% set href = '/product/' ~ product.slug|url_encode %}
<article class="product-card{{ photo ? '' : ' product-card-no-photo' }}">
  <a class="product-art{{ photo ? '' : ' product-art-empty' }}" href="{{ href }}" aria-label="Открыть {{ product.title }}, {{ product.sku }}">
    {% if photo %}<img src="{{ photo }}" alt="{{ product.title }} — {{ product.brand }}" width="640" height="480" loading="lazy" decoding="async">
    {% else %}<span>{{ _self.noPhoto(22) }}<small>Без фото</small></span>{% endif %}
  </a>
  <a class="product-title" href="{{ href }}">{{ product.title }}</a>
  <div class="product-meta"><span>{{ product.brand }}</span><span class="stock{{ product.availability_status == 'in_stock' ? ' ok' : '' }}">{{ _self.status(product.availability_status) }}</span></div>
  <div class="sku"><span>Артикул: <strong>{{ product.sku }}</strong></span>{{ _self.copy(product.sku) }}</div>
  <div class="product-bottom"><strong class="price">{{ _self.price(product) }}</strong>{{ _self.add(product) }}</div>
</article>
{% endautoescape %}{% endmacro %}
{% macro articleDate(value) %}{% autoescape 'html' %}
{%- set months = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'] -%}
{%- if value matches '/^[0-9]{4}-[0-9]{2}-[0-9]{2}/' -%}
  {{- value|date('j', 'UTC') }} {{ months[value|date('n', 'UTC') - 1] }} {{ value|date('Y', 'UTC') }} г.
{%- endif -%}
{% endautoescape %}{% endmacro %}
{% macro articleCard(entry, level = 3) %}{% autoescape 'html' %}
{% set photo = entry.cover_url|default('') ?: _self.asset(entry.cover_image|default('')) %}
{% set href = '/articles/' ~ entry.slug|url_encode %}
{% set tag = level == 2 ? 'h2' : 'h3' %}
<article class="article-card{{ photo ? ' article-card-with-image' : '' }}">
  {% if photo %}<a href="{{ href }}" tabindex="-1" aria-hidden="true" class="article-card-image"><img src="{{ photo }}" alt="" loading="lazy"></a>{% endif %}
  <div class="article-card-body">
    {% if entry.published_at|default('') %}<time class="article-date" datetime="{{ entry.published_at }}">{{ _self.articleDate(entry.published_at) }}</time>{% endif %}
    <{{ tag }}><a href="{{ href }}">{{ entry.title }}</a></{{ tag }}>
    {% if entry.excerpt|default('') %}<p>{{ entry.excerpt }}</p>{% endif %}
    <a class="article-read-link" href="{{ href }}" aria-label="Читать: {{ entry.title }}">Читать статью <span aria-hidden="true">→</span></a>
  </div>
</article>
{% endautoescape %}{% endmacro %}
{% macro catalogHref(params, patch = {}) %}{% autoescape 'html' %}
{%- set keys = ['q', 'brand', 'category', 'availability', 'partType', 'sort'] -%}
{%- set query = {} -%}
{%- for key in keys -%}
  {%- set value = key in patch|keys ? patch[key] : params[key]|default('') -%}
  {%- if value is not empty -%}{%- set query = query|merge({(key): value}) -%}{%- endif -%}
{%- endfor -%}
{%- if patch.page|default(0) > 1 -%}{%- set query = query|merge({page: patch.page}) -%}{%- endif -%}
{{- '/catalog' ~ (query ? '?' ~ query|url_encode : '') -}}
{% endautoescape %}{% endmacro %}
