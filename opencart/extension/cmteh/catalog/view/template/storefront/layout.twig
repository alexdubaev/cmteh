{% autoescape 'html' %}
{% set assets = '/extension/cmteh/catalog/view/assets/' %}
{% set templates = 'extension/cmteh/catalog/view/template/storefront/' %}
{% set screens = {home: 'home', catalog: 'catalog', brands: 'brands', brand: 'collection', category: 'collection', product: 'product', articles: 'articles', article: 'article', page: 'content', request: 'request', not_found: 'error', error: 'error'} %}
{% set brands = model.brands|default([]) %}
{% set categories = model.categories|default([]) %}
{% set headerNav = navigation.header ?? navigation|default([])|filter(item => item.location|default('') == 'header') %}
{% set footerNav = navigation.footer ?? navigation|default([])|filter(item => item.location|default('') == 'footer') %}
{% set legalNav = navigation.legal ?? navigation|default([])|filter(item => item.location|default('') == 'legal') %}
{% set home = model.home ?? (page == 'home' ? model.content|default({}) : {}) %}
{% set company = site.company_name|default('') %}
{% set digits = site.phone|default('')|replace({' ': '', '+': '', '(': '', ')': '', '-': '', '.': '', ' ': '', ' ': ''}) %}
{% set tel = digits matches '/^[0-9]+$/' ? 'tel:' ~ (site.phone starts with '+' ? '+' : '') ~ digits : '' %}
{% set title = meta.title|default(company) %}
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% if meta.description|default('') %}<meta name="description" content="{{ meta.description }}">{% endif %}
  {% if meta.canonical|default('') %}<link rel="canonical" href="{{ meta.canonical }}"><meta property="og:url" content="{{ meta.canonical }}">{% endif %}
  {% if meta.robots|default('') %}<meta name="robots" content="{{ meta.robots }}">{% endif %}
  <meta property="og:title" content="{{ title }}">
  <meta property="og:type" content="{{ page == 'article' ? 'article' : 'website' }}">
  {% if meta.description|default('') %}<meta property="og:description" content="{{ meta.description }}">{% endif %}
  {% if meta.image|default('') %}<meta property="og:image" content="{{ meta.image }}">{% endif %}
  <link rel="stylesheet" href="{{ assets }}theme.css">
  <link rel="stylesheet" href="{{ assets }}globals.css">
  <link rel="stylesheet" href="{{ assets }}home-ux.css">
  <link rel="stylesheet" href="{{ assets }}catalog-ux.css">
  <link rel="stylesheet" href="{{ assets }}request-ux.css">
  <link rel="stylesheet" href="{{ assets }}articles.css">
  <link rel="stylesheet" href="{{ assets }}responsive-ux.css">
  <link rel="stylesheet" href="{{ assets }}storefront.css">
  <script type="module" src="{{ assets }}storefront.mjs"></script>
  {% if page in ['request', 'page'] %}<script type="module" src="{{ assets }}request.mjs"></script>{% endif %}
  {% set graphs = jsonLd is iterable ? jsonLd : (jsonLd|default('') ? [jsonLd] : []) %}
  {% for graph in graphs %}<script type="application/ld+json">{{ graph|raw }}</script>{% endfor %}
</head>
<body>
  <a class="skip-link" href="#main-content" tabindex="0">К основному содержимому</a>
  {% include templates ~ 'header.twig' %}
  <main id="main-content" tabindex="-1">
    {% include templates ~ (screens[page]|default('error')) ~ '.twig' %}
  </main>
  {% include templates ~ 'footer.twig' %}
  <nav class="mobile-actions" aria-label="Быстрая навигация">
    <button type="button" class="mobile-action" data-focus-search aria-label="Перейти к поиску"><span class="mobile-action-icon" aria-hidden="true">⌕</span><span>Поиск</span></button>
    <a class="mobile-action" href="/catalog"><span class="mobile-action-icon" aria-hidden="true">▦</span><span>Каталог</span></a>
    <a class="mobile-action mobile-action-cart" href="/request" aria-label="Открыть корзину" data-cart-link="Открыть корзину">
      <span class="mobile-action-icon mobile-cart-icon" aria-hidden="true"><img src="{{ assets }}images/cart-icon-black.webp" alt="" width="20" height="20"><b data-cart-count hidden></b></span><span>Корзина</span>
    </a>
  </nav>
</body>
</html>
{% endautoescape %}
