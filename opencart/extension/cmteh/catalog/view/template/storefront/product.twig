{% autoescape 'html' %}
{% import templates ~ 'ui.twig' as ui %}
{% set product = model.product|default({}) %}
{% set brand = brands|filter(item => item.name == product.brand)|first %}
{% set heading = model.heading|default(product.heading|default(product.title ~ ' ' ~ product.brand ~ ' ' ~ product.sku)) %}
{% set photos = [] %}
{% if ui.asset(product.main_image|default('')) %}{% set photos = [{image: product.main_image, alt_text: product.title}] %}{% endif %}
{% for image in product.images|default([]) %}
  {% if ui.asset(image.image|default('')) and image.image not in photos|map(item => item.image) %}{% set photos = photos|merge([image]) %}{% endif %}
{% endfor %}
{% set codes = {'oem': 'OEM-номер', 'mpn': 'Номер производителя', 'supplier': 'Номер поставщика', 'previous': 'Прежний номер', 'superseded': 'Заменённый номер', 'external': 'Дополнительный номер', 'barcode': 'Штрихкод'} %}
{% set relationLabels = {'analog': 'Аналог', 'oem_cross': 'Перекрёстный OEM-номер', 'compatible': 'Совместимая позиция', 'superseded_by': 'Замена'} %}
<div class="shell page-shell">
  <div class="breadcrumbs"><a href="/">Главная</a><span>/</span><a href="/catalog">Каталог</a><span>/</span>
    {% if brand %}<a href="/brand/{{ brand.slug|url_encode }}">{{ product.brand }}</a>{% else %}<span>{{ product.brand }}</span>{% endif %}<span>/</span><span>{{ product.sku }}</span>
  </div>
  <section class="product-page panel{{ photos ? '' : ' product-page-no-photo' }}">
    <div class="product-media">
      {% if photos %}
        {% set first = photos|first %}
        <div class="product-gallery">
          <img class="product-main-image" src="{{ ui.asset(first.image) }}" alt="{{ first.alt_text|default(product.title) }}" width="1200" height="900" decoding="async">
          {% if photos|length > 1 %}<div class="product-thumbs" aria-label="Галерея товара">
            {% for image in photos|slice(0, 8) %}
              <button class="{{ loop.first ? 'active' : '' }}" type="button" data-gallery-src="{{ ui.asset(image.image) }}" aria-label="Показать изображение {{ loop.index }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}"><img src="{{ ui.asset(image.image) }}" alt="{{ image.alt_text|default(product.title ~ ', изображение ' ~ loop.index) }}" width="160" height="120" loading="lazy" decoding="async"></button>
            {% endfor %}
          </div>{% endif %}
        </div>
      {% else %}
        <div class="product-placeholder product-placeholder-compact" aria-label="Для {{ product.brand }} {{ product.sku }} фото не предоставлено">{{ ui.noPhoto(24) }}<span>Фото не предоставлено</span></div>
      {% endif %}
    </div>
    <div class="product-info">
      <div class="product-tags"><span>{{ product.brand }}</span>
        {% if ui.part(product.part_type|default('')) %}<span>{{ ui.part(product.part_type) }}</span>{% endif %}
        <span class="{{ product.availability_status == 'in_stock' ? 'ok' : '' }}">{{ ui.status(product.availability_status) }}</span>
      </div>
      <h1>{{ heading }}</h1>
      <div class="article-big"><span>Артикул <strong>{{ product.sku }}</strong></span>{{ ui.copy(product.sku) }}</div>
      <p>{{ product.short_description|default('Описание и применяемость уточняются по запросу.') }}</p>
      <div class="purchase-area"><div class="product-price">{{ ui.price(product) }}</div>{{ ui.add(product, true) }}<a class="button secondary wide" href="/request">Открыть корзину</a></div>
      <div class="product-trust"><div><strong>Поставка</strong><span>уточняется для выбранной позиции</span></div><div><strong>Документы</strong><span>состав документов согласуется при оформлении</span></div></div>
    </div>
  </section>
  <section class="product-details">
    <article class="panel"><h2>О товаре</h2>
      {# The catalog boundary supplies separately named, sanitized HTML when present. #}
      {% if product.full_description_html|default('') %}<div class="prose">{{ product.full_description_html|raw }}</div>{% else %}
      <p>{{ product.full_description|default(product.short_description|default('Дополнительную информацию по детали можно запросить у менеджера.')) }}</p>{% endif %}
      {% if product.category|default(null) %}<a class="text-link" href="/category/{{ product.category.slug|url_encode }}">Категория: {{ product.category.title }} →</a>{% endif %}
    </article>
    <article class="panel"><h2>Основные данные</h2><dl class="spec-list">
      <div><dt>Бренд</dt><dd>{{ product.brand }}</dd></div><div><dt>Артикул</dt><dd>{{ product.sku }}</dd></div>
      {% if product.mpn|default('') %}<div><dt>Номер производителя</dt><dd>{{ product.mpn }}</dd></div>{% endif %}
      <div><dt>Категория</dt><dd>{{ product.category.title|default('—') }}</dd></div>
      {% for spec in product.specification_items|default([]) %}<div><dt>{{ spec.name }}</dt><dd>{{ spec.value }}{% if spec.unit|default('') %} {{ spec.unit }}{% endif %}</dd></div>
      {% else %}{% for name, value in product.specifications|default({}) %}<div><dt>{{ name }}</dt><dd>{{ value }}</dd></div>{% endfor %}{% endfor %}
    </dl></article>
  </section>
  {% set documents = product.documents|default([])|filter(item => ui.asset(item.file|default(''))) %}
  {% if product.codes|default([]) or documents %}
    <section class="product-extra-grid">
      {% if product.codes|default([]) %}<article class="panel product-extra"><h2>Дополнительные номера</h2><div class="code-list">
        {% for code in product.codes %}<div><strong>{{ code.code }}</strong><span>{{ codes[code.code_type]|default('Дополнительный номер') }}</span></div>{% endfor %}
      </div></article>{% endif %}
      {% if documents %}<article class="panel product-extra"><h2>Файлы товара</h2><div class="document-list">
        {% for document in documents %}<a href="{{ ui.asset(document.file) }}" target="_blank" rel="noopener noreferrer"><span>Файл</span><strong>{{ document.title|default('Документ ' ~ loop.index) }}</strong><b aria-hidden="true">↗</b></a>{% endfor %}
      </div></article>{% endif %}
    </section>
  {% endif %}
  {% set related = {} %}
  {% for relation in product.relations|default([]) %}
    {% if relation.product.slug != product.slug %}
      {% set entry = related[relation.product.slug]|default({product: relation.product, kinds: []}) %}
      {% set kinds = relation.relation_type in entry.kinds ? entry.kinds : entry.kinds|merge([relation.relation_type]) %}
      {% set related = related|merge({(relation.product.slug): {product: entry.product, kinds: kinds}}) %}
    {% endif %}
  {% endfor %}
  {% for kind in ['analog', 'other'] %}
    {% set analogous = kind == 'analog' %}
    {% set entries = related|filter(entry => ('analog' in entry.kinds) == analogous) %}
    {% if entries %}<section class="section product-relations">
      <div class="section-heading"><div><h2>{{ analogous ? 'Аналоги из каталога' : 'Связанные позиции' }}</h2><p>{{ analogous ? 'Применяемость для вашей техники уточните при подборе.' : 'Связи указаны в каталоге. Они не заменяют проверку применяемости и направления замены.' }}</p></div></div>
      <div class="product-grid">{% for relation in entries %}<div class="relation-wrap">{% for type in relation.kinds %}<span class="relation-type">{{ relationLabels[type]|default('Связь в каталоге') }}</span>{% endfor %}{{ ui.card(relation.product) }}</div>{% endfor %}</div>
    </section>{% endif %}
  {% endfor %}
  {% set other = model.related|default([])|filter(item => item.slug != product.slug and item.slug not in related|keys) %}
  {% if other %}<section class="section related-section"><div class="section-heading"><div><h2>{{ product.category|default(null) ? 'Другие товары категории' : 'Другие товары каталога' }}</h2></div></div>
    <div class="product-grid">{% for item in other|slice(0, 4) %}{{ ui.card(item) }}{% endfor %}</div>
  </section>{% endif %}
</div>
{% endautoescape %}
