{% autoescape 'html' %}
{% import templates ~ 'ui.twig' as ui %}
{% set heroPhoto = home.hero_image_url|default('') %}
{% set mobilePhoto = home.hero_mobile_image_url|default('') %}
{% set primary = ui.href(home.hero_primary_button_url|default('')) %}
{% set secondary = ui.href(home.hero_secondary_button_url|default('')) %}
{% set brands = model.home_brands|default([]) %}
{% for block in model.home_blocks|default([]) %}
  {% include templates ~ 'home-' ~ block.key ~ '.twig' %}
{% endfor %}
{% endautoescape %}
