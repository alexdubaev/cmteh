{% autoescape 'html' %}
{% import templates ~ 'ui.twig' as ui %}
{% set heroPhoto = home.hero_image_url|default('') %}
{% set mobilePhoto = home.hero_mobile_image_url|default('') %}
{% set primary = ui.href(home.hero_primary_button_url|default('')) %}
{% set secondary = ui.href(home.hero_secondary_button_url|default('')) %}
{% if heroPhoto or home.hero_title|default('') or home.hero_text|default('') %}
<section class="hero{{ heroPhoto and not mobilePhoto ? ' hero-cms-image' : '' }}">
  {% if heroPhoto %}
  <picture class="hero-background"{% if not home.hero_image_alt|default('') %} aria-hidden="true"{% endif %}>
    {% if mobilePhoto %}<source media="(max-width: 820px)" srcset="{{ mobilePhoto }}">{% endif %}
    <img src="{{ heroPhoto }}" alt="{{ home.hero_image_alt|default('') }}" width="2172" height="724" fetchpriority="high">
  </picture>
  {% endif %}
  <div class="shell hero-grid"><div class="hero-copy">
    {% if home.hero_title|default('') %}<h1>{% for line in home.hero_title|split(' ', 3) %}<span>{{ line }}</span>{% if not loop.last %} {% endif %}{% endfor %}</h1>{% endif %}
    {% if home.hero_text|default('') %}<p>{{ home.hero_text }}</p>{% endif %}
    {% if primary and home.hero_primary_button_text|default('') or secondary and home.hero_secondary_button_text|default('') %}
      <div class="hero-cms-actions">
        {% if primary and home.hero_primary_button_text|default('') %}<a class="button primary" href="{{ primary }}">{{ home.hero_primary_button_text }}</a>{% endif %}
        {% if secondary and home.hero_secondary_button_text|default('') %}<a class="button secondary" href="{{ secondary }}">{{ home.hero_secondary_button_text }}</a>{% endif %}
      </div>
    {% endif %}
  </div></div>
  {% if home.hero_article_link_text|default('') or home.hero_brand_link_text|default('') %}
    <div class="shell hero-quicklinks" aria-label="Быстрый поиск">
      {% if home.hero_quick_title|default('') %}<strong>{{ home.hero_quick_title }}</strong>{% endif %}
      {% if home.hero_article_link_text|default('') %}<a href="#article-search" data-focus-search><span aria-hidden="true">⌕</span>{{ home.hero_article_link_text }} <b aria-hidden="true">→</b></a>{% endif %}
      {% if home.hero_brand_link_text|default('') and brands %}<a href="#brands"><span aria-hidden="true">⚙</span>{{ home.hero_brand_link_text }} <b aria-hidden="true">→</b></a>{% endif %}
    </div>
  {% endif %}
</section>
{% endif %}
{% if brands %}<section class="brand-strip" id="brands"><div class="shell">
  <div class="brand-strip-heading">
    {% if home.brands_title|default('') %}<strong>{{ home.brands_title }}</strong>{% endif %}
    {% if home.brands_link_text|default('') %}<a class="all-brands" href="/brands">{{ home.brands_link_text }} →</a>{% endif %}
  </div>
  <div class="brand-list" tabindex="0" role="region" aria-label="Бренды">
    {% for brand in brands %}<a href="/brand/{{ brand.slug|url_encode }}">{{ brand.name }}</a>{% endfor %}
  </div>
  {% if home.brands_scroll_hint|default('') %}<p class="brand-scroll-hint">{{ home.brands_scroll_hint }} →</p>{% endif %}
</div></section>{% endif %}
{% set rootCategories = categories|filter(item => not item.parent_slug|default('')) %}
{% if rootCategories %}
<section class="section shell home-categories"{% if home.categories_title|default('') %} aria-labelledby="home-categories-title"{% endif %}>
  <div class="section-heading">
    {% if home.categories_title|default('') %}<h2 id="home-categories-title">{{ home.categories_title }}</h2>{% endif %}
    {% if home.categories_link_text|default('') %}<a href="/catalog">{{ home.categories_link_text }} →</a>{% endif %}
  </div>
  <div class="home-category-grid">{% for category in rootCategories|slice(0, 8) %}<a class="home-category-link" href="/category/{{ category.slug|url_encode }}">{{ category.title }}</a>{% endfor %}</div>
</section>
{% endif %}
<section class="section shell home-products">
  <div class="section-heading">
    {% if home.products_title|default('') %}<div><h2>{{ home.products_title }}</h2></div>{% endif %}
    {% if home.products_link_text|default('') %}<a href="/catalog">{{ home.products_link_text }} →</a>{% endif %}
  </div>
  {% if model.products|default([]) %}
    <div class="product-grid home-product-grid">{% for product in model.products|slice(0, 6) %}{{ ui.card(product) }}{% endfor %}</div>
  {% else %}
    <div class="panel empty-state"><p>Каталог временно недоступен или пока не содержит опубликованных товаров.</p><a class="button primary" href="/request?import=1">Отправить список</a></div>
  {% endif %}
</section>
{% set sections = home.sections|default([]) %}
{% for section in sections|filter(item => item.section_type|default('') == 'home_order') %}
  {% include templates ~ 'sections.twig' with {sections: [section]} %}
{% endfor %}
{% set entries = model.entries|default([]) %}
{% if entries %}<section class="section shell articles-home-section"{% if home.articles_title|default('') %} aria-labelledby="home-articles-title"{% endif %}>
  <div class="section-heading">
    {% if home.articles_title|default('') %}<h2 id="home-articles-title">{{ home.articles_title }}</h2>{% endif %}
    {% if home.articles_link_text|default('') %}<a href="/articles" class="article-all-link">{{ home.articles_link_text }} <span aria-hidden="true">→</span></a>{% endif %}
  </div>
  <div class="articles-grid">{% for entry in entries|slice(0, 3) %}{{ ui.articleCard(entry) }}{% endfor %}</div>
</section>{% endif %}
{% set more = sections|filter(item => item.section_type|default('') != 'home_order') %}
{% if more %}<section class="shell home-cms-sections">{% include templates ~ 'sections.twig' with {sections: more} %}</section>{% endif %}
{% endautoescape %}
