{% autoescape 'html' %}
{% import templates ~ 'ui.twig' as ui %}
{% for section in sections %}
  {% set type = section.section_type|default('custom') %}
  {% set href = ui.href(section.button_url|default('')) %}
  {% set photo = section.image_url|default('') ?: ui.asset(section.image|default('')) %}
  {% if type == 'home_order' %}
    <section class="section shell home-order">
      {% if section.title|default('') %}<div class="section-heading"><h2>{{ section.title }}</h2></div>{% endif %}
      {% if section.items|default([]) is iterable and section.items is not empty %}
        <ol class="home-order-steps">
          {% for item in section.items %}<li><span class="home-step-number" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span><h3>{{ item.title }}</h3>{% if item.text|default('') %}<p>{{ item.text }}</p>{% endif %}</li>{% endfor %}
        </ol>
      {% endif %}
      {% if section.text_html|default('') or href and section.button_text|default('') %}
        <div class="home-order-next">{% if section.text_html|default('') %}<div class="prose">{{ section.text_html|raw }}</div>{% endif %}
          {% if href and section.button_text|default('') %}<a class="button primary" href="{{ href }}">{{ section.button_text }}</a>{% endif %}
        </div>
      {% endif %}
    </section>
  {% elseif type in ['steps', 'columns', 'features'] %}
    {% set gridClass = {steps: 'steps-grid', columns: 'two-columns', features: 'feature-cards'} %}
    {% if section.title|default('') or section.text_html|default('') %}
      <div class="panel prose">{% if section.title|default('') %}<h2>{{ section.title }}</h2>{% endif %}{% if section.text_html|default('') %}{{ section.text_html|raw }}{% endif %}</div>
    {% endif %}
    {% if section.items|default([]) is iterable and section.items is not empty %}
      <section class="{{ gridClass[type] }}">
        {% for item in section.items %}
          {% set itemHref = ui.href(item.url|default(item.href|default(''))) %}
          <article class="panel{{ type == 'columns' ? ' prose' : '' }}">
            {% if type in ['steps', 'features'] %}<span{% if type == 'features' %} class="feature-number"{% endif %}>{{ '%02d'|format(loop.index) }}</span>{% endif %}
            {% if item.title|default('') %}{% if type == 'steps' %}<h3>{{ item.title }}</h3>{% else %}<h2>{{ item.title }}</h2>{% endif %}{% endif %}
            {% set description = item.text_from|default('') == 'vat_info' ? site.vat_info|default(item.text|default('')) : item.text|default('') %}
            {% if description %}<p>{{ description }}</p>{% endif %}
            {% if item.links_from|default('') == 'categories' and categories %}<ul>{% for category in categories|slice(0, 8) %}<li><a class="text-link" href="/category/{{ category.slug|url_encode }}">{{ category.title }}</a></li>{% endfor %}</ul>{% endif %}
            {% if itemHref and item.button_text|default('') %}<a class="button primary" href="{{ itemHref }}">{{ item.button_text }}</a>{% endif %}
          </article>
        {% endfor %}
      </section>
    {% endif %}
  {% elseif type == 'delivery_intro' %}
    <section class="info-hero panel">
      <div>{% if section.title|default('') %}<h2>{{ section.title }}</h2>{% endif %}{% if section.text_html|default('') %}<div class="prose">{{ section.text_html|raw }}</div>{% endif %}</div>
      <div class="info-symbol" aria-hidden="true">→</div>
    </section>
  {% else %}
    {% set cta = type in ['cta', 'parts_request', 'lead_form'] %}
    <div class="cms-sections">
    <section class="panel cms-section {{ cta ? 'callout cms-cta' : 'cms-section-' ~ type }}">
      <div class="{{ cta ? '' : 'cms-section-copy' }}">
        {% if section.title|default('') %}<h2>{{ section.title }}</h2>{% endif %}
        {% if section.subtitle|default('') %}<p>{{ section.subtitle }}</p>{% endif %}
        {% if section.text_html|default('') %}<div class="prose">{{ section.text_html|raw }}</div>{% endif %}
        {% if href and section.button_text|default('') and not cta %}<a class="button primary" href="{{ href }}">{{ section.button_text }}</a>{% endif %}
      </div>
      {% if href and section.button_text|default('') and cta %}<a class="button primary" href="{{ href }}">{{ section.button_text }}</a>{% endif %}
      {% if photo and not cta %}<div class="cms-section-media"><img src="{{ photo }}" alt="{{ section.image_alt|default(section.title|default('')) }}" loading="lazy"></div>{% endif %}
      {% if section.items|default([]) is iterable and section.items is not empty and not cta %}
        <div class="{{ type == 'faq' ? 'cms-faq' : 'cms-item-grid' }}">
        {% for item in section.items %}
          {% set label = item is iterable ? item.title|default(item.name|default(item.label|default(item.question|default('')))) : item %}
          {% set description = item is iterable ? item.text|default(item.description|default(item.answer|default(item.value|default('')))) : '' %}
          {% set itemHref = ui.href(item.url|default(item.href|default(item.link|default('')))) %}
          {% if type == 'faq' and label %}<details><summary>{{ label }}</summary>{% if description %}<p>{{ description }}</p>{% endif %}</details>
          {% elseif label or description %}
            {% set tag = itemHref ? 'a' : 'div' %}
            <{{ tag }} class="cms-item"{% if itemHref %} href="{{ itemHref }}"{% endif %}><span>{{ '%02d'|format(loop.index) }}</span><strong>{{ label }}</strong>{% if description %}<p>{{ description }}</p>{% endif %}</{{ tag }}>
          {% endif %}
        {% endfor %}
        </div>
      {% endif %}
    </section>
    </div>
  {% endif %}
{% endfor %}
{% endautoescape %}
