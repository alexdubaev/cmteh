{% autoescape 'html' %}
{% set content = model.content|default(content|default({})) %}
{% set slug = model.slug|default(content.slug|default('')) %}
{% set titles = {'about': 'О компании', 'contacts': 'Контакты', 'delivery': 'Доставка', 'payment': 'Оплата'} %}
{% set headings = {'about': 'О компании ' ~ company, 'contacts': 'Контакты', 'delivery': 'Доставка запчастей', 'payment': 'Оплата по согласованным условиям'} %}
{% set intros = {
 'contacts': 'Свяжитесь с нами по телефону, email или через форму. Для расчёта укажите артикулы и количество; сведения о технике добавьте в комментарий.',
 'delivery': 'Способ, стоимость и срок доставки согласуются при подтверждении заявки с учётом склада, веса и габаритов заказа.',
 'payment': 'Заявка через сайт не требует оплаты. Перед оформлением поставки получите подтверждение состава заказа, стоимости и условий оплаты.'
} %}
{% set title = content.title|default(titles[slug]|default(meta.title|default(company))) %}
<div class="shell page-shell">
  <div class="breadcrumbs"><a href="/">Главная</a><span>/</span><span>{{ title }}</span></div>
  <div class="page-title">
    <h1>{{ content.h1|default(content.title|default(headings[slug]|default(title))) }}</h1>
    {% if slug == 'about' and not content %}
      <p>{{ company }} — поставщик запчастей для спецтехники. В каталоге представлены детали разных производителей{% if brands %}: {{ brands|slice(0, 6)|map(brand => brand.name)|join(', ') }}{% endif %}.</p>
      <a class="button primary" href="/contacts">Связаться с нами</a>
    {% elseif content.intro|default(intros[slug]|default('')) %}
      <p>{{ content.intro|default(intros[slug]) }}</p>
    {% endif %}
  </div>
  {% if content %}
    {% if content.body_html|default(content.content|default('')) %}<section class="panel prose">{{ content.body_html|default(content.content)|raw }}</section>{% endif %}
    {% if content.sections|default([]) %}{% include templates ~ 'sections.twig' with {sections: content.sections} %}{% endif %}
    {% if content.seo_text|default('') %}<section class="panel prose cms-seo-text"><p>{{ content.seo_text }}</p></section>{% endif %}
  {% elseif slug == 'about' %}
    <section class="two-columns">
      <article class="panel prose"><h2>Ассортимент</h2><p>Основные разделы каталога помогают найти детали по узлу техники. Название, артикул, цена и наличие указаны в карточке каждой позиции.</p>
        {% if categories %}<ul>{% for category in categories|slice(0, 8) %}<li><a class="text-link" href="/category/{{ category.slug|url_encode }}">{{ category.title }}</a></li>{% endfor %}</ul>{% endif %}
      </article>
      <article class="panel prose"><h2>Работа с заявками</h2><p>Передайте артикулы, количество и контактные данные. Заявка нужна для подтверждения наличия, стоимости и условий конкретной поставки; она не является оплатой заказа.</p><a class="text-link" href="/request?import=1">Передать список позиций →</a></article>
    </section>
  {% elseif slug == 'delivery' %}
    <section class="info-hero panel"><div><h2>Что указать для расчёта доставки</h2><p>Передайте город получения и список позиций. Вес, габариты, стоимость и срок доставки нужно подтвердить для конкретного заказа.</p></div><div class="info-symbol">→</div></section>
    <section class="steps-grid">
      <article class="panel"><span>01</span><h3>Согласование</h3><p>Подтверждаем позиции, сроки и способ доставки.</p></article>
      <article class="panel"><span>02</span><h3>Оплата</h3><p>Формируем документы по согласованным условиям.</p></article>
      <article class="panel"><span>03</span><h3>Комплектация</h3><p>Собираем заказ и подготавливаем его к отправке.</p></article>
      <article class="panel"><span>04</span><h3>Отправка</h3><p>Передаём заказ выбранному перевозчику.</p></article>
    </section>
    <section class="two-columns">
      <article class="panel prose"><h2>Место получения</h2><p>Сообщите, нужен ли вам терминал перевозчика или конкретный адрес. Возможность выбранного способа доставки и требования к упаковке подтверждаются для вашего заказа.</p></article>
      <article class="panel prose"><h2>Нужен срок и стоимость?</h2><p>Добавьте позиции в заявку — менеджер сможет рассчитать поставку по конкретному составу заказа.</p><a class="button primary" href="/request">Рассчитать поставку</a></article>
    </section>
  {% elseif slug == 'payment' %}
    <section class="feature-cards">
      <article class="panel"><span class="feature-number">01</span><h2>Заявка</h2><p>Передайте артикулы и количество удобным способом.</p></article>
      <article class="panel"><span class="feature-number">02</span><h2>Предложение</h2><p>Получите подтверждённые цены, сроки и условия поставки.</p></article>
      <article class="panel"><span class="feature-number">03</span><h2>Оплата и документы</h2><p>{{ site.vat_info|default('До оплаты уточните способ расчёта, условия НДС и перечень документов по своему заказу.') }}</p></article>
    </section>
    <section class="panel callout"><div><h2>Отправьте список позиций</h2><p>Артикулы из каталога, ручной список, CSV или XLSX попадут в одну заявку.</p></div><a class="button primary" href="/request?import=1">Отправить список</a></section>
  {% endif %}
  {% if slug == 'contacts' %}
    <div class="contact-grid{{ content ? ' contact-cms-tail' : '' }}">
      <section class="panel contact-card">
        <div><small>Телефон</small>{% if tel matches '/^\d+$/' %}<a href="tel:{{ site.phone starts with '+' ? '+' : '' }}{{ tel }}">{{ site.phone }}</a>{% else %}<strong>Уточните у менеджера</strong>{% endif %}</div>
        <div><small>Email</small>{% if site.email|default('') %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% else %}<strong>Уточните у менеджера</strong>{% endif %}</div>
        <div><small>Режим работы</small><strong>{{ site.working_hours|default('Уточните у менеджера') }}</strong></div>
        <div><small>Адрес</small><strong>{{ [site.city|default(''), site.address|default('')]|filter(value => value)|join(', ')|default('Уточните у менеджера') }}</strong></div>
        {% if site.inn|default('') or site.kpp|default('') or site.ogrn|default('') %}<div><small>Реквизиты</small><strong>{{ [site.inn|default('') ? 'ИНН ' ~ site.inn : '', site.kpp|default('') ? 'КПП ' ~ site.kpp : '', site.ogrn|default('') ? 'ОГРН ' ~ site.ogrn : '']|filter(value => value)|join(' · ') }}</strong></div>{% endif %}
        <div class="contact-map"><span>КОНТАКТЫ</span><strong>{{ site.city|default(company) }}</strong><small>{{ site.address|default('Перед посещением уточните адрес по телефону или email') }}</small></div>
      </section>
      {% include templates ~ 'lead-form.twig' with {leadType: 'contact'} %}
    </div>
  {% endif %}
</div>
{% endautoescape %}
