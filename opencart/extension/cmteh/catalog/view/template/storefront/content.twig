{% autoescape 'html' %}
{% import templates ~ 'ui.twig' as ui %}
{% set content = model.content|default({}) %}
{% set slug = model.slug|default('') %}
{% set title = content.title|default(meta.title|default(company)) %}
{% set ctaUrl = ui.href(content.button_url|default('')) %}
<div class="shell page-shell">
  <div class="breadcrumbs"><a href="/">Главная</a><span>/</span><span>{{ title }}</span></div>
  <div class="page-title">
    <h1>{{ content.h1|default(title) }}</h1>
    {% if content.intro|default('') %}<p>{{ content.intro }}</p>{% endif %}
    {% if ctaUrl and content.button_text|default('') %}<a class="button primary" href="{{ ctaUrl }}">{{ content.button_text }}</a>{% endif %}
  </div>
  {% include templates ~ 'editorial.twig' with {content: content} %}
  {% if slug == 'contacts' %}
    <div class="contact-grid contact-cms-tail">
      <section class="panel contact-card">
        {% if tel %}<div><small>Телефон</small><a href="{{ tel }}">{{ site.phone }}</a></div>{% endif %}
        {% if site.email|default('') %}<div><small>Email</small><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>{% endif %}
        <details class="contact-more"><summary>Адрес, режим работы и реквизиты</summary>
        {% if site.working_hours|default('') %}<div><small>Режим работы</small><strong>{{ site.working_hours }}</strong></div>{% endif %}
        {% if site.city|default('') or site.address|default('') %}<div><small>Адрес</small><strong>{{ [site.city|default(''), site.address|default('')]|filter(value => value)|join(', ') }}</strong></div>{% endif %}
        {% if site.inn|default('') or site.kpp|default('') or site.ogrn|default('') %}<div><small>Реквизиты</small><strong>{{ [site.inn|default('') ? 'ИНН ' ~ site.inn : '', site.kpp|default('') ? 'КПП ' ~ site.kpp : '', site.ogrn|default('') ? 'ОГРН ' ~ site.ogrn : '']|filter(value => value)|join(' · ') }}</strong></div>{% endif %}
        </details>
        {% if site.yandex_map_src|default('') %}
          <div style="grid-column:1/-1">
            <iframe title="Офис на Яндекс Картах" src="{{ site.yandex_map_src }}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" sandbox="allow-scripts allow-same-origin allow-popups" allowfullscreen style="display:block;width:100%;height:clamp(280px,30vw,320px);border:0"></iframe>
          </div>
        {% endif %}
      </section>
      {% include templates ~ 'lead-form.twig' with {leadType: 'contact'} %}
    </div>
  {% endif %}
</div>
{% endautoescape %}
