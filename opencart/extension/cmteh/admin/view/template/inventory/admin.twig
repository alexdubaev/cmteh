{{ header }}{{ column_left }}
<div id="content" class="container-fluid">
  <div class="page-header"><div class="container-fluid"><div class="float-end"><a class="btn btn-outline-secondary" href="index.php?route=extension/cmteh/module/cmteh_catalog&user_token={{ user_token|url_encode }}">Каталог</a></div><h1>Склады и предложения</h1><p class="text-muted mb-0">Остатки, предложения и ручные складские операции</p></div></div>
  <div class="container-fluid">
    {% if error and form.inventory_action not in ['preview','apply_import'] %}<div class="alert alert-danger" role="alert">{{ error|escape }}</div>{% endif %}
    {% if notice and not receipt %}<div class="alert alert-success" role="status">{{ notice|escape }}</div>{% endif %}

    <section class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Склады</h2></div><div class="card-body">
      {% if can_write %}<form method="post" action="{{ action|escape }}" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="inventory_action" value="inventory.warehouse.save"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="warehouse_id" value="0"><input type="hidden" name="expected_warehouse_version" value="0">
        <div class="col-md"><label class="form-label">Код</label><input class="form-control" name="code" maxlength="64" required value="{{ form.code|default('')|escape }}"></div><div class="col-md"><label class="form-label">Название</label><input class="form-control" name="name" maxlength="160" required value="{{ form.name|default('')|escape }}"></div><div class="col-md"><label class="form-label">Город</label><input class="form-control" name="city" maxlength="160" value="{{ form.city|default('')|escape }}"></div><div class="col-md"><label class="form-label">Срок по умолчанию</label><input class="form-control" name="delivery_term" maxlength="255" value="{{ form.delivery_term|default('')|escape }}"></div><div class="col-md"><label class="form-label">Внутренняя заметка</label><input class="form-control" name="note" maxlength="5000" value="{{ form.note|default('')|escape }}"></div><div class="col-auto"><button class="btn btn-primary">Добавить склад</button></div>
      </form>{% endif %}
      {% if warehouses %}<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Склад</th><th>Город и срок</th><th>Доступ</th><th>Действия</th></tr></thead><tbody>{% for warehouse in warehouses %}<tr><td><strong>{{ warehouse.code|escape }} · {{ warehouse.name|escape }}</strong><div class="small text-muted">{{ warehouse.active ? 'Активен' : 'Архив' }}{% if warehouse.address %} · {{ warehouse.address|escape }}{% endif %}{% if warehouse.note %} · {{ warehouse.note|escape }}{% endif %}</div></td><td>{{ warehouse.city|escape }}<br>{{ warehouse.delivery_term|escape }}</td><td>Версия {{ warehouse.version }}</td><td>{% if can_write and warehouse.active %}<details><summary class="btn btn-outline-secondary btn-sm">Изменить</summary><form method="post" action="{{ action|escape }}" class="row g-2 mt-2"><input type="hidden" name="inventory_action" value="inventory.warehouse.save"><input type="hidden" name="request_key" value="{{ request_key }}-e{{ warehouse.warehouse_id }}"><input type="hidden" name="warehouse_id" value="{{ warehouse.warehouse_id }}"><input type="hidden" name="expected_warehouse_version" value="{{ warehouse.version }}"><div class="col-6"><label class="form-label">Код</label><input class="form-control form-control-sm" name="code" value="{{ warehouse.code|escape }}" maxlength="64" required></div><div class="col-6"><label class="form-label">Название</label><input class="form-control form-control-sm" name="name" value="{{ warehouse.name|escape }}" maxlength="160" required></div><div class="col-6"><label class="form-label">Город</label><input class="form-control form-control-sm" name="city" value="{{ warehouse.city|escape }}" maxlength="160"></div><div class="col-6"><label class="form-label">Срок по умолчанию</label><input class="form-control form-control-sm" name="delivery_term" value="{{ warehouse.delivery_term|escape }}" maxlength="255"></div><div class="col-6"><label class="form-label">Внутренний адрес</label><input class="form-control form-control-sm" name="address" value="{{ warehouse.address|escape }}" maxlength="1000"></div><div class="col-6"><label class="form-label">Внутренняя заметка</label><input class="form-control form-control-sm" name="note" value="{{ warehouse.note|escape }}" maxlength="5000"></div><div class="col-12"><button class="btn btn-primary btn-sm">Сохранить</button></div></form></details><form method="post" action="{{ action|escape }}" class="mt-1"><input type="hidden" name="inventory_action" value="inventory.warehouse.archive"><input type="hidden" name="request_key" value="{{ request_key }}-a{{ warehouse.warehouse_id }}"><input type="hidden" name="warehouse_id" value="{{ warehouse.warehouse_id }}"><input type="hidden" name="expected_warehouse_version" value="{{ warehouse.version }}"><button class="btn btn-outline-danger btn-sm">Архивировать</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="text-muted mb-0">Склады ещё не созданы.</p>{% endif %}
    </div></section>

    <section class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Импорт Excel/CSV</h2></div><div class="card-body">
      <p class="small text-muted">Шаблон: article;warehouse_code;quantity;price;delivery_term. Последний столбец source_id можно добавить для однозначного выбора товара. Количество — абсолютный целый остаток. Цена — предложение для клиента в рублях; пустая цена означает «по запросу». Пустой срок наследует срок склада. Отсутствующие строки не меняются.</p>
      {% if can_write %}<form method="post" enctype="multipart/form-data" action="{{ action|escape }}" data-inventory-import>
        <input type="hidden" name="inventory_action" value="preview"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="xlsx_rows" value="" data-xlsx-rows>
        {% if error and form.inventory_action in ['preview','apply_import'] %}<div class="alert alert-danger mt-3" role="alert" tabindex="-1" data-inventory-focus>{{ error|escape }}</div>{% endif %}
        {% if receipt %}<div class="alert alert-success mt-3" role="status" tabindex="-1" data-inventory-focus>Импорт применён целиком: {{ receipt.rows }} строк, {{ receipt.commands }} складских команд.{% if receipt.replayed %} Возвращена сохранённая квитанция предыдущего применения.{% endif %}</div>{% endif %}
        <div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label" for="inventory-file">CSV или XLSX</label><input class="form-control" type="file" id="inventory-file" name="import_file" accept=".csv,.xlsx" required data-inventory-file></div><div class="col-md-3"><div class="form-check"><input class="form-check-input" type="checkbox" name="publish_offers" value="1" id="publish-offers"><label class="form-check-label" for="publish-offers">Опубликовать предложения из файла</label></div></div><div class="col-md-4"><button class="btn btn-primary" type="submit">Проверить и показать preview</button></div></div>
        <details class="mt-3"><summary>Распределение старого остатка</summary><p class="small text-muted mt-2">Для нераспределённого товара укажите фактические количества по всем складам в этом файле. Если сумма отличается от старого общего остатка, подтвердите разницу и укажите причину.</p><div class="form-check"><input class="form-check-input" type="checkbox" name="confirm_cutover" value="1" id="confirm-cutover"><label class="form-check-label" for="confirm-cutover">Подтверждаю переход складского учёта</label></div><label class="form-label mt-2">Причина расхождения</label><input class="form-control" name="cutover_reason" maxlength="1000" value="{{ form.cutover_reason|default('')|escape }}"></details>
      </form>{% endif %}
      {% if preview %}<div class="mt-3" data-import-preview id="inventory-preview" tabindex="-1" data-inventory-focus><h3 class="h6">Preview до {{ preview.expires_at|escape }}</h3><p>Проверено строк: {{ preview.summary.rows }} · Изменений: {{ preview.summary.changed }} · Переходов: {{ preview.summary.cutovers }} · Ошибок: {{ preview.summary.errors }} · Показана страница {{ preview.page }} из {{ preview.pages }} (до 100 строк)</p>
        {% if preview.errors %}<div class="alert alert-danger"><strong>Первые ошибки на этой странице:</strong><ul class="mb-0">{% for item in preview.errors %}<li>Строка {{ item.row }}: {{ item.message|escape }}</li>{% endfor %}</ul></div>{% endif %}
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Строка</th><th>Артикул / склад</th><th>До</th><th>После</th></tr></thead><tbody>{% for row in preview.rows %}<tr><td>{{ row.row }}</td><td>{{ row.article|escape }} · {{ row.warehouse_code|escape }}{% if row.cutover %}<span class="badge text-bg-warning ms-1">Переход</span>{% endif %}</td><td>{% if row.before.label %}{{ row.before.label|escape }}: {% endif %}{{ row.before.quantity }} шт{% if row.cutover and row.cutover_difference is defined %} · разница {{ row.cutover_difference }} шт{% endif %}{% if row.before.price %} · {{ row.before.price|escape }} руб{% endif %}</td><td>{{ row.after.quantity }} шт · {{ row.after.price|default('по запросу')|escape }} · {{ row.after.delivery_term|escape }}{% if row.after.published %} · опубликовано{% else %} · скрыто{% endif %}</td></tr>{% endfor %}</tbody></table></div>
        {% if preview.can_apply and can_write %}<form method="post" action="{{ action|escape }}"><input type="hidden" name="inventory_action" value="apply_import"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="preview_id" value="{{ preview.preview_id }}"><input type="hidden" name="digest" value="{{ preview.digest }}"><input type="hidden" name="import_page" value="{{ preview.page }}"><button class="btn btn-success">Применить весь preview целиком</button></form>{% endif %}
        {% if preview.pages > 1 %}<nav class="d-flex justify-content-between mt-2" aria-label="Страницы preview"><span>{% if preview_previous %}<a class="btn btn-outline-secondary btn-sm" href="{{ preview_previous|escape }}">Предыдущая часть</a>{% endif %}</span><span>Страница {{ preview.page }} из {{ preview.pages }}</span><span>{% if preview_next %}<a class="btn btn-outline-secondary btn-sm" href="{{ preview_next|escape }}">Следующая часть</a>{% endif %}</span></nav>{% endif %}
      </div>{% endif %}
    </div></section>

    <section class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Остатки и предложения</h2></div><div class="card-body">
      <form method="get" class="row g-2 mb-3"><input type="hidden" name="route" value="extension/cmteh/module/cmteh_catalog.inventory"><input type="hidden" name="user_token" value="{{ user_token }}"><div class="col-md-4"><label class="form-label">Артикул или код склада</label><input class="form-control" name="search" value="{{ search|escape }}"></div><div class="col-md-3"><label class="form-label">Склад</label><select class="form-select" name="warehouse_id"><option value="0">Все склады</option>{% for warehouse in warehouses %}<option value="{{ warehouse.warehouse_id }}"{% if filter_warehouse == warehouse.warehouse_id %} selected{% endif %}>{{ warehouse.code|escape }} · {{ warehouse.name|escape }}</option>{% endfor %}</select></div><div class="col-md-2"><label class="form-label">ID товара</label><input class="form-control" name="product_id" type="number" min="1" value="{{ filter_product ?: '' }}"></div><div class="col-auto align-self-end"><button class="btn btn-outline-primary">Найти</button></div></form>
      {% if balances.rows %}<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Товар / склад</th><th>На руках</th><th>Резерв</th><th>Доступно</th><th>Предложение</th><th>Операции</th></tr></thead><tbody>{% for row in balances.rows %}<tr><td>{{ row.sku|default(row.source_id)|default(row.product_id)|escape }}<br><small>{{ row.warehouse_code|escape }} · {{ row.warehouse_name|escape }}</small></td><td>{{ row.on_hand }}</td><td>{{ row.reserved }}</td><td>{{ row.available }}</td><td>{% if can_write %}<details><summary>{{ row.price|default('по запросу') }} · {{ row.published ? 'опубликовано' : 'скрыто' }}</summary><form method="post" action="{{ action|escape }}" class="row g-1 mt-1"><input type="hidden" name="inventory_action" value="inventory.offer.update"><input type="hidden" name="request_key" value="{{ request_key }}-p{{ row.product_id }}w{{ row.warehouse_id }}"><input type="hidden" name="product_id" value="{{ row.product_id }}"><input type="hidden" name="warehouse_id" value="{{ row.warehouse_id }}"><input type="hidden" name="expected_product_version" value="{{ row.state.version }}"><input type="hidden" name="expected_balance_version" value="{{ row.version }}"><input type="hidden" name="expected_warehouse_version" value="{{ row.warehouse_version }}"><div class="col-12"><label class="form-label">Цена предложения, руб.</label><input class="form-control form-control-sm" name="price" value="{{ row.price|default('') }}" inputmode="decimal"></div><div class="col-12"><label class="form-label">Срок для товара (пусто — срок склада)</label><input class="form-control form-control-sm" name="delivery_term" value="{{ row.delivery_term|escape }}" maxlength="255"></div><div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="published" value="1" id="pub-{{ row.product_id }}-{{ row.warehouse_id }}"{% if row.published %} checked{% endif %}><label class="form-check-label" for="pub-{{ row.product_id }}-{{ row.warehouse_id }}">Опубликовать</label></div><div class="col-12"><button class="btn btn-outline-primary btn-sm">Сохранить предложение</button></div></form></details>{% else %}{{ row.price|default('по запросу') }}{% endif %}</td><td>{% if can_write %}<details><summary>Записать</summary><form method="post" action="{{ action|escape }}" class="row g-1 mt-1"><input type="hidden" name="request_key" value="{{ request_key }}-m{{ row.product_id }}w{{ row.warehouse_id }}"><input type="hidden" name="product_id" value="{{ row.product_id }}"><input type="hidden" name="warehouse_id" value="{{ row.warehouse_id }}"><input type="hidden" name="expected_product_version" value="{{ row.state.version }}"><input type="hidden" name="expected_balance_version" value="{{ row.version }}"><input type="hidden" name="expected_warehouse_version" value="{{ row.warehouse_version }}"><div class="col-12"><select class="form-select form-select-sm" name="inventory_action"><option value="inventory.balance.count">Пересчёт</option><option value="inventory.balance.receive">Поступление</option><option value="inventory.balance.issue">Списание</option><option value="inventory.reservation.create">Резерв</option></select></div><div class="col-12"><input class="form-control form-control-sm" name="quantity" type="number" min="0" step="1" value="{{ row.on_hand }}" aria-label="Количество"></div><div class="col-12"><input class="form-control form-control-sm" name="reason" required maxlength="1000" placeholder="Причина операции"></div><div class="col-12"><button class="btn btn-primary btn-sm">Подтвердить</button></div></form></details>{% if row.targets %}<details class="mt-1"><summary>Переместить</summary><form method="post" action="{{ action|escape }}" class="row g-1 mt-1" data-transfer-form><input type="hidden" name="inventory_action" value="inventory.transfer.complete"><input type="hidden" name="request_key" value="{{ request_key }}-t{{ row.product_id }}w{{ row.warehouse_id }}"><input type="hidden" name="product_id" value="{{ row.product_id }}"><input type="hidden" name="warehouse_id" value="{{ row.warehouse_id }}"><input type="hidden" name="expected_product_version" value="{{ row.state.version }}"><input type="hidden" name="expected_balance_version" value="{{ row.version }}"><input type="hidden" name="expected_warehouse_version" value="{{ row.warehouse_version }}"><div class="col-12"><select class="form-select form-select-sm" name="to_warehouse_id" data-transfer-target>{% for target in row.targets %}<option value="{{ target.id }}" data-version="{{ target.version }}" data-balance-version="{{ target.balance_version }}">{{ target.code|escape }}</option>{% endfor %}</select></div><input type="hidden" name="expected_to_warehouse_version" value="{{ row.targets[0].version }}" data-target-version><input type="hidden" name="expected_to_balance_version" value="{{ row.targets[0].balance_version }}" data-target-balance-version><div class="col-12"><input class="form-control form-control-sm" name="quantity" type="number" min="1" max="{{ row.available }}" step="1" required placeholder="Количество"></div><div class="col-12"><input class="form-control form-control-sm" name="reason" maxlength="1000" required placeholder="Причина"></div><div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="arrival_confirmed" value="1" required id="arrival-{{ row.product_id }}-{{ row.warehouse_id }}"><label class="form-check-label" for="arrival-{{ row.product_id }}-{{ row.warehouse_id }}">Уже прибыло</label></div><div class="col-12"><button class="btn btn-outline-primary btn-sm">Записать перемещение</button></div></form></details>{% endif %}{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="text-muted">Пока нет распределённых складских остатков.</p>{% endif %}
      <nav class="d-flex justify-content-between mt-2" aria-label="Страницы"><span>{% if previous %}<a class="btn btn-outline-secondary btn-sm" href="{{ previous|escape }}">Назад</a>{% endif %}</span><span>Страница {{ balances.page }} · строк {{ balances.total }}</span><span>{% if next %}<a class="btn btn-outline-secondary btn-sm" href="{{ next|escape }}">Далее</a>{% endif %}</span></nav>
    </div></section>

    <div class="row"><div class="col-12">
      <section class="card h-100"><div class="card-header"><h2 class="h5 mb-0">Последние движения и резервы</h2></div><div class="card-body"><h3 class="h6">Движения</h3>{% if history %}<ul class="list-group list-group-flush mb-3">{% for movement in history %}<li class="list-group-item px-0"><strong>{{ movement.kind|escape }}</strong> · {{ movement.reason|escape }} · {{ movement.actor_label|escape }} · {{ movement.created_at|escape }}</li>{% endfor %}</ul>{% else %}<p class="small text-muted">История пока пуста.</p>{% endif %}<h3 class="h6">Резервы</h3>{% if reservations %}<ul class="list-group list-group-flush">{% for reservation in reservations %}<li class="list-group-item px-0">Товар {{ reservation.product_id }}, склад {{ reservation.warehouse_id }} · {{ reservation.quantity }} шт · {{ reservation.state|escape }}{% if can_write and reservation.state == 'active' %}<form method="post" action="{{ action|escape }}" class="d-inline-flex gap-1 ms-2"><input type="hidden" name="product_id" value="{{ reservation.product_id }}"><input type="hidden" name="warehouse_id" value="{{ reservation.warehouse_id }}"><input type="hidden" name="expected_product_version" value="{{ reservation.state_snapshot.version }}"><input type="hidden" name="expected_balance_version" value="{{ reservation.balance_snapshot.version }}"><input type="hidden" name="expected_warehouse_version" value="{{ reservation.warehouse_version }}"><input type="hidden" name="reservation_id" value="{{ reservation.reservation_id }}"><input type="hidden" name="expected_reservation_version" value="{{ reservation.version }}"><input type="hidden" name="request_key" value="{{ request_key }}-r{{ reservation.reservation_id }}"><select class="form-select form-select-sm" name="inventory_action"><option value="inventory.reservation.release">Снять целиком</option><option value="inventory.reservation.ship">Отгрузить целиком</option></select><input type="hidden" name="reason" value="Подтверждено оператором"><button class="btn btn-outline-primary btn-sm">Подтвердить</button></form>{% endif %}</li>{% endfor %}</ul>{% else %}<p class="small text-muted mb-0">Активных резервов нет.</p>{% endif %}</div></section></div></div>
  </div>
</div>
<script type="module" src="/extension/cmteh/catalog/view/assets/inventory-admin.mjs?v=20261111-2"></script>
{{ footer }}
