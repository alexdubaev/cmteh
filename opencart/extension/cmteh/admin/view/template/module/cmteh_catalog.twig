{% import _self as editor %}
{% macro image(name, id, value, preview, can_browse_images) %}
  <div class="d-flex align-items-center gap-2">
    <img src="{{ preview|escape }}" alt="" id="thumb-{{ id|escape }}" width="60" height="45" style="object-fit:contain" data-oc-placeholder="/image/no_image.png">
    <input type="text" class="form-control" id="{{ id|escape }}" {% if name %}name="{{ name|escape }}"{% else %}data-section-field="image_path"{% endif %} value="{{ value|escape }}" placeholder="catalog/logo.webp">
    {% if can_browse_images %}
      <button class="btn btn-outline-primary" type="button" data-oc-toggle="image" data-oc-target="#{{ id|escape }}" data-oc-thumb="#thumb-{{ id|escape }}">Выбрать</button>
    {% endif %}
    <button class="btn btn-outline-secondary" type="button" data-oc-toggle="clear" data-editor-clear-image data-oc-target="#{{ id|escape }}" data-oc-thumb="#thumb-{{ id|escape }}">Очистить</button>
  </div>
{% endmacro %}
{% macro move_buttons(label) %}
  <div class="btn-group btn-group-sm" role="group" aria-label="{{ label|escape }}">
    <button type="button" class="btn btn-outline-secondary" data-editor-move="-1">Выше</button>
    <button type="button" class="btn btn-outline-secondary" data-editor-move="1">Ниже</button>
    <button type="button" class="btn btn-outline-danger" data-editor-remove>Удалить</button>
  </div>
{% endmacro %}
{% macro item(row, fields) %}
  <div class="border rounded p-3 mb-2" data-editor-item data-key="{{ row.key|default('')|escape }}">
    {% for field, label in fields %}
      <label class="form-label d-block">{{ label|escape }}
        {% if field == 'text' %}
          <textarea class="form-control" data-item-field="{{ field|escape }}" rows="2">{{ row.values[field]|default('')|escape }}</textarea>
        {% elseif field == 'text_from' or field == 'links_from' %}
          {% set choice = field == 'text_from' ? 'vat_info' : 'categories' %}
          {% set value = row.values[field]|default('') %}
          <select class="form-select" data-item-field="{{ field|escape }}">
            <option value="">Выключено</option>
            <option value="{{ choice }}"{% if value == choice %} selected{% endif %}>{{ field == 'text_from' ? 'Информация о НДС' : 'Категории каталога' }}</option>
            {% if value and value != choice %}<option value="{{ value|escape }}" selected>{{ value|escape }}</option>{% endif %}
          </select>
        {% else %}
          <input class="form-control" type="text" data-item-field="{{ field|escape }}" value="{{ row.values[field]|default('')|escape }}">
        {% endif %}
      </label>
    {% endfor %}
    {{ _self.move_buttons('Порядок пункта') }}
  </div>
{% endmacro %}
{% macro section(row, identifier, fields, types, item_fields, can_browse_images, language) %}
  <fieldset class="border rounded p-3 mb-3" data-editor-section data-key="{{ row.key|default('')|escape }}">
    <legend class="float-none w-auto fs-6 px-2">Раздел</legend>
    {% for field, label in fields %}
      <div class="mb-3">
        <label class="form-label" for="{{ identifier|escape }}-{{ field|escape }}">{{ label|escape }}</label>
        {% set value = row.values[field]|default('') %}
        {% if field == 'section_type' %}
          <select id="{{ identifier|escape }}-{{ field|escape }}" class="form-select" data-section-field="{{ field|escape }}">
            {% if value and types[value] is not defined %}<option value="{{ value|escape }}" selected>{{ value|escape }}</option>{% endif %}
            {% for key, text in types %}<option value="{{ key|escape }}"{% if value == key %} selected{% endif %}>{{ text|escape }}</option>{% endfor %}
          </select>
        {% elseif field == 'text' %}
          <textarea id="{{ identifier|escape }}-{{ field|escape }}" class="form-control" data-section-field="{{ field|escape }}" data-cmteh-rich data-lang="{{ language|escape }}" rows="4">{{ value|escape }}</textarea>
        {% elseif field == 'image_path' %}
          {{ _self.image('', identifier ~ '-' ~ field, value, row.preview|default('/image/no_image.png'), can_browse_images) }}
        {% else %}
          <input id="{{ identifier|escape }}-{{ field|escape }}" type="text" class="form-control" data-section-field="{{ field|escape }}" value="{{ value|escape }}">
        {% endif %}
      </div>
    {% endfor %}
    <details class="mb-3"{% if row.items|default([]) %} open{% endif %}>
      <summary>Пункты, карточки или вопросы раздела</summary>
      <div data-editor-items class="mt-2">
        {% for item in row.items|default([]) %}{{ _self.item(item, item_fields) }}{% endfor %}
      </div>
      <button class="btn btn-outline-primary btn-sm" type="button" data-editor-add-item>Добавить пункт</button>
    </details>
    {{ _self.move_buttons('Порядок раздела') }}
  </fieldset>
{% endmacro %}
{% macro collection(name, title, rows, columns, options) %}
  <fieldset class="border rounded p-3 my-3" data-collection="{{ name|escape }}">
    <legend class="float-none w-auto fs-6 px-2">{{ title|escape }}</legend>
    <input type="hidden" name="{{ name }}_present" value="1">
    <div data-collection-rows>
      {% for row in rows %}{{ _self.collection_row(name, row, columns, options, loop.index0) }}{% endfor %}
    </div>
    <button type="button" class="btn btn-outline-primary btn-sm" data-collection-add>Добавить строку</button>
    <template>{{ _self.collection_row(name, {}, columns, options, 0) }}</template>
  </fieldset>
{% endmacro %}
{% macro collection_row(name, row, columns, options, index) %}
  <div class="border rounded p-2 mb-2" data-collection-row>
    <div class="row">
    {% for key, label in columns %}
      <div class="col-md mb-2"><label class="form-label d-block">{{ label|escape }}
        {% if options[key] is defined %}
          <select class="form-select" name="{{ name }}[{{ index }}][{{ key }}]" data-column="{{ key }}">
            {% for value, text in options[key] %}<option value="{{ value|escape }}"{% if value ~ '' == row[key]|default('') ~ '' %} selected{% endif %}>{{ text|escape }}</option>{% endfor %}
          </select>
        {% else %}
          <input type="text" class="form-control" name="{{ name }}[{{ index }}][{{ key }}]" data-column="{{ key }}" value="{{ row[key]|default('')|escape }}">
        {% endif %}
      </label></div>
    {% endfor %}
    </div>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-collection-move="-1">Выше</button>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-collection-move="1">Ниже</button>
    <button type="button" class="btn btn-outline-danger btn-sm" data-collection-remove>Убрать строку</button>
  </div>
{% endmacro %}
{% macro selected(name, title, selected, choices) %}
  <fieldset class="border rounded p-3 my-3" data-selection="{{ name }}">
    <legend class="float-none w-auto fs-6 px-2">{{ title|escape }}</legend>
    <p class="form-text">Порядок строк задаёт порядок на главной. На витрине показываются только опубликованные записи.</p>
    <input type="hidden" name="{{ name }}_present" value="1">
    <div data-selection-rows>
      {% for slug in selected %}{{ _self.selected_row(name, slug, choices) }}{% endfor %}
    </div>
    <button type="button" class="btn btn-outline-primary btn-sm" data-selection-add>Добавить запись</button>
    <template>{{ _self.selected_row(name, '', choices) }}</template>
  </fieldset>
{% endmacro %}
{% macro selected_row(name, slug, choices) %}
  <div class="d-flex gap-2 mb-2" data-selection-row>
    <select class="form-select" name="{{ name }}[]">
      {% for choice in choices %}<option value="{{ choice.slug|escape }}"{% if choice.slug == slug %} selected{% endif %}>{{ choice.title|escape }}{% if choice.status != 'published' %} (скрыто){% endif %}</option>{% endfor %}
    </select>
    <button type="button" class="btn btn-outline-secondary" data-selection-move="-1">Выше</button>
    <button type="button" class="btn btn-outline-secondary" data-selection-move="1">Ниже</button>
    <button type="button" class="btn btn-outline-danger" data-selection-remove>Убрать</button>
  </div>
{% endmacro %}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid"><h1>Каталог и публикации СМ ТЕХНО</h1></div>
  </div>
  <div class="container-fluid">
    {% if error %}<div class="alert alert-danger" role="alert">{{ error|escape }}</div>{% endif %}
    {% if deleted %}<div class="alert alert-success" role="status">Запись удалена. Её старый адрес возвращает 410.</div>{% endif %}
    {% if saved %}<div class="alert alert-success" role="status">Запись сохранена</div>{% endif %}
    <ul class="nav nav-tabs mb-3">
      {% for tab in tabs %}
        <li class="nav-item"><a class="nav-link{% if tab.active %} active{% endif %}" href="{{ tab.href|escape }}">{{ tab.title|escape }}</a></li>
      {% endfor %}
    </ul>
    {% if show_form %}
      <div class="card mb-3">
        <div class="card-header">{{ type_label|escape }}</div>
        <div class="card-body">
          <form id="cmteh-editor" action="{{ action|escape }}" method="post" data-store-origin="{{ store_origin|escape }}">
            <fieldset{% if not can_write %} disabled{% endif %}>
              <input type="hidden" name="id" value="{{ record.id|escape }}">
              {% if native_href %}<p><a href="{{ native_href|escape }}">Открыть штатную форму OpenCart</a></p>{% endif %}
              {% if public_href %}<p><a href="{{ public_href|escape }}" target="_blank" rel="noopener">Открыть на сайте</a></p>{% endif %}
              {% if edit_id %}<details class="mb-3"><summary>Предпросмотр сохранённого материала в админке</summary>
                <p class="form-text">Этот просмотр доступен только в авторизованной админке. Изменения видны после сохранения.</p>
                <iframe title="Предпросмотр материала" sandbox="" referrerpolicy="no-referrer" srcdoc="{{ preview_html|escape }}" style="width:100%;min-height:280px;border:1px solid #ddd"></iframe>
              </details>{% endif %}
              {% if type != 'site' and type != 'home' %}
                <div class="mb-3">
                  <label class="form-label" for="record-slug">Адрес записи</label>
                  <input class="form-control" id="record-slug" name="slug" maxlength="160" value="{{ record.slug|escape }}" placeholder="Будет взят из названия, если оставить пустым">
                  {% if edit_id %}<div class="form-check mt-2"><input class="form-check-input" type="checkbox" id="confirm-slug" name="confirm_slug_change" value="1"><label class="form-check-label" for="confirm-slug">Подтверждаю изменение адреса и прямое перенаправление 301 со старого URL</label></div>{% endif %}
                </div>
              {% endif %}
              {% for item in fields %}
                <div class="mb-3">
                  <label class="form-label" for="field-{{ item.field|escape }}">{{ item.label|escape }}</label>
                  {% if item.select %}
                    <select class="form-select" id="field-{{ item.field|escape }}" name="{{ item.field|escape }}">
                      {% for option, label in item.control %}
                        <option value="{{ option|escape }}"{% if option ~ '' == item.value ~ '' %} selected{% endif %}>{{ label|escape }}</option>
                      {% endfor %}
                    </select>
                  {% elseif item.control in ['textarea', 'rich'] %}
                    <textarea class="form-control" rows="4" id="field-{{ item.field|escape }}" name="{{ item.field|escape }}"{% if item.control == 'rich' %} data-cmteh-rich data-lang="{{ ckeditor_lang|escape }}"{% endif %}>{{ item.value|escape }}</textarea>
                  {% elseif item.control == 'image' %}
                    {{ editor.image(item.field, 'field-' ~ item.field, item.value, item.preview, can_browse_images) }}
                  {% else %}
                    <input class="form-control" type="{% if item.control in ['number', 'integer'] %}number{% else %}text{% endif %}"{% if item.control == 'number' %} min="0" step="0.0001"{% endif %} id="field-{{ item.field|escape }}" name="{{ item.field|escape }}" value="{{ item.value|escape }}">
                  {% endif %}
                  {% if item.field == 'yandex_map_embed' %}<p class="form-text">В Яндекс Картах выберите «Поделиться» → «Виджет с картой» (iframe), в Конструкторе — «Получить код карты» → iframe. Вставьте код или ссылку виджета. После сохранения останется только ссылка. Очистите поле, чтобы убрать карту со страницы контактов.</p>{% endif %}
                </div>
              {% endfor %}
              {% if type == 'navigation' %}
                <label class="form-label d-block">Внутренняя страница, категория или бренд
                  <select class="form-select" name="internal_target"><option value="">Внешняя ссылка — укажите адрес ниже</option>
                    {% for path, title in targets %}<option value="{{ path|escape }}"{% if path == record.url %} selected{% endif %}>{{ title|escape }}</option>{% endfor %}
                  </select>
                </label>
                <label class="form-label d-block">Внешний URL (https://…)
                  <input type="url" class="form-control" name="external_url" value="{% if targets[record.url] is not defined %}{{ record.url|escape }}{% endif %}" placeholder="https://example.org/">
                </label>
              {% endif %}
              {% if type == 'product' %}
                <label class="form-label d-block" for="product-categories">Дополнительные категории</label>
                <input type="hidden" name="category_slugs_present" value="1">
                <select multiple class="form-select mb-3" id="product-categories" name="category_slugs[]" size="6">
                  {% for choice in choices.category %}<option value="{{ choice.slug|escape }}"{% if choice.slug in record.category_slugs|default([]) %} selected{% endif %}>{{ choice.title|escape }}{% if choice.status != 'published' %} (скрыто){% endif %}</option>{% endfor %}
                </select>
                {{ editor.collection('specification_items', 'Характеристики', record.specification_items|default([]), {'group_name':'Группа', 'name':'Характеристика', 'value':'Значение', 'unit':'Единица'}, {}) }}
                {{ editor.collection('codes', 'Дополнительные коды', record.codes|default([]), {'code':'Код', 'code_type':'Вид кода', 'source_name':'Источник'}, {'code_type':{'oem':'OEM','mpn':'MPN','supplier':'Поставщик','previous':'Предыдущий','superseded':'Заменённый','external':'Внешний','barcode':'Штрихкод'}}) }}
                {{ editor.collection('relations', 'Связанные товары', record.relations|default([]), {'source_id':'Товар','relation_type':'Вид связи'}, relation_options) }}
                {% for media, caption in {'images':'Подпись изображения', 'documents':'Название документа'} %}
                  <fieldset class="border rounded p-3 my-3" data-stored-media><legend class="float-none w-auto fs-6 px-2">{{ media == 'images' ? 'Дополнительные изображения' : 'Документы' }}</legend>
                  <p class="form-text">Управляйте подписями и убирайте существующие вложения. Новые публичные фото добавляются в штатной форме OpenCart.</p>
                  <input type="hidden" name="{{ media }}_present" value="1">
                  {% for item in record[media]|default([]) %}<div class="d-flex gap-2 mb-2" data-media-row>
                    <label class="form-label flex-fill">{{ caption }} <input class="form-control" name="{{ media }}[{{ loop.index0 }}][{{ media == 'images' ? 'alt_text' : 'title' }}]" value="{{ (media == 'images' ? item.alt_text : item.title)|default('')|escape }}"></label>
                    <button type="button" class="btn btn-outline-danger" data-media-remove>Убрать</button>
                  </div>{% else %}<p>Вложений нет.</p>{% endfor %}
                  </fieldset>
                {% endfor %}
              {% endif %}
              {% if type == 'home' %}
                <h2 class="h5">Порядок и видимость блоков</h2>
                <input type="hidden" name="home_blocks_present" value="1">
                {% for block in home_blocks %}<div class="row align-items-center mb-2">
                  <div class="col-md-6 form-check"><input class="form-check-input" type="checkbox" name="home_blocks[{{ block.key }}][enabled]" id="block-{{ block.key }}" value="1"{% if block.enabled %} checked{% endif %}><label class="form-check-label" for="block-{{ block.key }}">{{ block.label|escape }}</label></div>
                  <div class="col-md-3"><label class="form-label">Порядок: {{ block.label|escape }}<input class="form-control" type="number" min="-10000" max="10000" name="home_blocks[{{ block.key }}][sort_order]" value="{{ block.sort_order|escape }}"></label></div>
                </div>{% endfor %}
                <label class="form-label d-block">Бренды на главной<select class="form-select" name="brands_mode">
                  <option value="auto"{% if record.brands_mode|default('auto') == 'auto' %} selected{% endif %}>Все опубликованные автоматически</option><option value="selected"{% if record.brands_mode == 'selected' %} selected{% endif %}>Выбранные ниже</option></select></label>
                {{ editor.selected('brand_slugs','Выбранные бренды',record.brand_slugs|default([]),choices.brand) }}
                <label class="form-label d-block">Категории на главной<select class="form-select" name="categories_mode">
                  <option value="auto_roots"{% if record.categories_mode|default('auto_roots') == 'auto_roots' %} selected{% endif %}>Корневые автоматически</option><option value="auto_all"{% if record.categories_mode == 'auto_all' %} selected{% endif %}>Все, включая вложенные</option><option value="selected"{% if record.categories_mode == 'selected' %} selected{% endif %}>Выбранные ниже</option></select></label>
                <label class="form-label d-block">Лимит категорий (0 — все)<input class="form-control" name="categories_limit" type="number" min="0" max="300" value="{{ record.categories_limit|default(8)|escape }}"></label>
                {{ editor.selected('category_slugs','Выбранные категории',record.category_slugs|default([]),choices.category) }}
              {% endif %}
              {% if type == 'site' %}{{ editor.collection('social_links', 'Социальные сети и мессенджеры', record.social_links|default([]), {'label':'Название','url':'Ссылка'}, {}) }}{% endif %}
              {% if type == 'product' %}
                <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="zero-price" name="confirm_zero_price" value="1"{% if record.confirm_zero_price %} checked{% endif %}><label class="form-check-label" for="zero-price">Нулевая цена подтверждена</label></div>
              {% endif %}
              {% if show_sections %}
                <h2 class="h5 mt-4">Разделы</h2>
                <input type="hidden" name="sections_json" id="editor-sections-json" value="">
                <input type="hidden" name="sections_revision" value="{{ section_revision|escape }}">
                <div id="editor-sections">
                  {% for section in sections %}
                    {{ editor.section(section, 'editor-section-' ~ loop.index0, section_fields, section_types, item_fields, can_browse_images, ckeditor_lang) }}
                  {% endfor %}
                </div>
                <button type="button" class="btn btn-outline-primary mb-3" data-editor-add-section>Добавить раздел</button>
                <template id="editor-section-template">{{ editor.section({}, 'editor-section-new', section_fields, section_types, item_fields, can_browse_images, ckeditor_lang) }}</template>
                <template id="editor-item-template">{{ editor.item({}, item_fields) }}</template>
              {% endif %}
            </fieldset>
            {% if can_write %}<button class="btn btn-primary" type="submit">Сохранить</button>{% endif %}
          </form>
          {% if can_write and edit_id and type not in ['home','site'] %}
            <details class="mt-4"><summary>Удаление записи</summary>
              <p>Рекомендуется выбрать статус «Черновик» или «В архиве», чтобы сохранить историю. Удаление необратимо, старый адрес вернёт 410. Связанные категории и бренды нельзя удалить до снятия связей.</p>
              <form action="{{ action|escape }}" method="post" data-delete-form>
                <input type="hidden" name="action" value="delete">
                <label class="form-check-label"><input type="checkbox" name="confirm_delete" value="1" required> Подтверждаю удаление этой записи</label>
                <button type="submit" class="btn btn-outline-danger ms-2">Удалить запись</button>
              </form>
            </details>
          {% endif %}
        </div>
      </div>
    {% endif %}
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>{{ type_label|escape }}</span>
        {% if can_write %}<a class="btn btn-primary" href="{{ new_record|escape }}">Новая запись</a>{% endif %}
      </div>
      <form class="card-body row g-2" action="{{ filter_action|escape }}" method="get">
        <input type="hidden" name="route" value="extension/cmteh/module/cmteh_catalog"><input type="hidden" name="user_token" value="{{ user_token|escape }}"><input type="hidden" name="type" value="{{ type|escape }}">
        <div class="col-md-6"><label class="form-label" for="catalog-search">Поиск по названию, артикулу или адресу</label><input class="form-control" type="search" name="search" id="catalog-search" value="{{ search|escape }}"></div>
        <div class="col-md-4"><label class="form-label" for="catalog-status">Статус публикации</label><select class="form-select" name="status" id="catalog-status">{% for value,label in {'':'Все','published':'Опубликовано','draft':'Черновик','archived':'В архиве'} %}<option value="{{ value }}"{% if filter_status == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
        <div class="col-md-2 align-self-end"><button class="btn btn-outline-primary" type="submit">Найти</button></div>
      </form>
      <div class="table-responsive">
        <table class="table">
          <thead><tr><th scope="col">Запись</th><th scope="col">Адрес</th><th scope="col">Статус</th><th scope="col">OpenCart</th></tr></thead>
          <tbody>
          {% for row in rows %}
            <tr><td><a href="{{ row.href|escape }}">{{ (row.title ?: row.id)|escape }}</a></td><td>{{ row.slug|escape }}</td><td>{{ row.status == 'published' ? 'Опубликовано' : (row.status == 'archived' ? 'В архиве' : 'Черновик') }}</td><td>{% if row.native_href %}<a href="{{ row.native_href|escape }}">Штатная форма</a>{% endif %}</td></tr>
          {% else %}
            <tr><td colspan="4">Записи не найдены. Измените поиск или создайте новую запись.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% if previous or next %}
        <div class="card-footer">
          {% if previous %}<a class="btn btn-outline-secondary" href="{{ previous|escape }}">Назад</a>{% endif %}
          {% if next %}<a class="btn btn-outline-secondary" href="{{ next|escape }}">Далее</a>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% if show_form and can_write %}
  <script>
  (() => {
    const form = document.getElementById('cmteh-editor');
    const sections = document.getElementById('editor-sections');
    const editorOptions = {
      language: '{{ ckeditor_lang|escape('js') }}',
      removePlugins: 'iframe,youtube{% if not can_browse_images %},opencart{% endif %}',
      toolbar_Custom: [
        ['Maximize'], ['Undo', 'Redo'],
        ['Format', 'Bold', 'Italic', 'Underline', 'Strike'],
        ['NumberedList', 'BulletedList', 'Blockquote'],
        ['Link', 'Unlink', 'Image'{% if can_browse_images %}, 'OpenCart'{% endif %}, 'Table', 'HorizontalRule']
      ]
    };
    let nextSection = {{ sections|length }};

    function installEditors(container) {
      if (window.CKEDITOR) {
        $(container).find('[data-cmteh-rich]').ckeditor(editorOptions);
      }
    }

    function flushEditors(container, destroy = false) {
      if (!window.CKEDITOR) return;
      for (const input of container.querySelectorAll('[data-cmteh-rich]')) {
        const instance = CKEDITOR.instances[input.id];
        if (!instance) continue;
        instance.updateElement();
        if (destroy) instance.destroy(true);
      }
    }

    function normalizeImages(input) {
      if (!input.value.includes('<img')) return;
      const content = new DOMParser().parseFromString(input.value, 'text/html');
      const store = new URL(form.dataset.storeOrigin, location.origin);
      let changed = false;
      for (const image of content.querySelectorAll('img[src]')) {
        const raw = image.getAttribute('src');
        let url;
        try { url = new URL(raw, store); } catch { continue; }
        const path = store.pathname.replace(/\/$/, '') + '/image/catalog/';
        if (url.origin === store.origin && url.pathname.startsWith(path) && !url.search && !url.hash) {
          const relative = '/image/catalog/' + url.pathname.slice(path.length);
          if (relative !== raw) {
            image.setAttribute('src', relative);
            changed = true;
          }
        }
      }
      if (changed) input.value = content.body.innerHTML;
    }

    function values(element, attribute) {
      const data = {key: element.dataset.key};
      for (const field of element.querySelectorAll('[' + attribute + ']')) {
        data[field.getAttribute(attribute)] = field.value;
      }
      return data;
    }

    function addSection() {
      const fragment = document.getElementById('editor-section-template').content.cloneNode(true);
      for (const element of fragment.querySelectorAll('[id], [for], [data-oc-target], [data-oc-thumb]')) {
        for (const attribute of ['id', 'for', 'data-oc-target', 'data-oc-thumb']) {
          if (element.hasAttribute(attribute)) {
            element.setAttribute(attribute, element.getAttribute(attribute).replace('editor-section-new', 'editor-section-' + nextSection));
          }
        }
      }
      nextSection++;
      const section = fragment.firstElementChild;
      sections.append(fragment);
      installEditors(section);
      section.querySelector('select').focus();
    }

    form.addEventListener('click', event => {
      const button = event.target.closest('button');
      if (!button) return;
      if (button.hasAttribute('data-editor-clear-image')) {
        const field = document.querySelector(button.dataset.ocTarget);
        if (field) field.dataset.clearLegacy = '1';
      } else if (button.hasAttribute('data-editor-add-section')) {
        addSection();
      } else if (button.hasAttribute('data-editor-add-item')) {
        const fragment = document.getElementById('editor-item-template').content.cloneNode(true);
        const item = fragment.firstElementChild;
        button.closest('[data-editor-section]').querySelector('[data-editor-items]').append(fragment);
        item.querySelector('input').focus();
      } else if (button.hasAttribute('data-editor-remove')) {
        const row = button.closest('[data-editor-item], [data-editor-section]');
        const focus = row.nextElementSibling || row.previousElementSibling;
        flushEditors(row, true);
        row.remove();
        (focus?.querySelector('input, select, button') || form.querySelector('[data-editor-add-section]'))?.focus();
      } else if (button.hasAttribute('data-editor-move')) {
        const row = button.closest('[data-editor-item], [data-editor-section]');
        const up = button.dataset.editorMove === '-1';
        const sibling = up ? row.previousElementSibling : row.nextElementSibling;
        if (!sibling) return;
        flushEditors(row, true);
        if (up) sibling.before(row);
        else sibling.after(row);
        installEditors(row);
        button.focus();
      }
    });
    form.addEventListener('formdata', event => {
      flushEditors(form);
      for (const input of form.querySelectorAll('[data-cmteh-rich]')) {
        normalizeImages(input);
        if (input.name) event.formData.set(input.name, input.value);
      }
      for (const field of form.querySelectorAll('[name][data-clear-legacy]')) {
        if (field.value === '') event.formData.set('clear_legacy[' + field.name + ']', '1');
      }
      if (sections) {
        const rows = Array.from(sections.children, section => ({
          ...values(section, 'data-section-field'),
          clear_legacy_image: section.querySelector('[data-section-field="image_path"]').dataset.clearLegacy === '1',
          items: Array.from(section.querySelector('[data-editor-items]').children, item => values(item, 'data-item-field'))
        }));
        event.formData.set('sections_json', JSON.stringify(rows));
      }
    });
    function reindexCollections() {
      for (const collection of form.querySelectorAll('[data-collection]')) {
        [...collection.querySelector('[data-collection-rows]').children].forEach((row,index) => {
          for (const input of row.querySelectorAll('[data-column]')) input.name = `${collection.dataset.collection}[${index}][${input.dataset.column}]`;
        });
      }
    }
    form.addEventListener('click', event => {
      const button = event.target.closest('button');
      if (!button) return;
      if (button.hasAttribute('data-media-remove')) { button.closest('[data-media-row]').remove(); return; }
      for (const kind of ['collection','selection']) {
        const container = button.closest(`[data-${kind}]`);
        if (!container) continue;
        if (button.hasAttribute(`data-${kind}-add`)) {
          const fragment = container.querySelector('template').content.cloneNode(true);
          container.querySelector(`[data-${kind}-rows]`).append(fragment);
          reindexCollections();
        } else if (button.hasAttribute(`data-${kind}-remove`)) {
          button.closest(`[data-${kind}-row]`).remove(); reindexCollections();
        } else if (button.hasAttribute(`data-${kind}-move`)) {
          const row = button.closest(`[data-${kind}-row]`);
          const up = button.getAttribute(`data-${kind}-move`) === '-1';
          const sibling = up ? row.previousElementSibling : row.nextElementSibling;
          if (sibling) { if (up) sibling.before(row); else sibling.after(row); reindexCollections(); }
        }
      }
    });
    form.addEventListener('submit', reindexCollections);
    reindexCollections();
    installEditors(form);
  })();
  </script>
{% endif %}
