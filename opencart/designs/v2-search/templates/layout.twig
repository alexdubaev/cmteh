{% autoescape 'html' %}
{% set assets = '/extension/cmteh/catalog/view/assets/' %}
{% set templates = 'extension/cmteh/catalog/view/template/storefront/' %}
{% set screens = {home: 'home', catalog: 'v2/catalog', brands: 'brands', brand: 'collection', category: 'collection', product: 'v2/product', articles: 'articles', article: 'article', page: 'content', request: 'request', 'parts-list': 'parts-list', not_found: 'error', error: 'error'} %}
{% set brands = model.brands|default([]) %}
{% set categories = model.categories|default([]) %}
{% set product = model.product|default({}) %}
{% set primaryCategory = product.category|default({}) %}
{% set primaryCategorySlug = primaryCategory.slug|default('') %}
{% set productCategory = primaryCategorySlug ? (categories|filter(item => item.slug == primaryCategorySlug)|first|default(null)) : null %}
{% set categoryTrail = [] %}
{% set categoryPathValid = false %}
{% if page == 'product' and productCategory and productCategory.slug|default('') %}
  {% set categoryPathValid = true %}
  {% set currentCategory = productCategory %}
  {% for depth in 1..(categories|length + 1) %}
    {% if currentCategory and currentCategory.slug|default('') and currentCategory.slug not in categoryTrail|map(item => item.slug) %}
      {% set categoryTrail = categoryTrail|merge([currentCategory]) %}
      {% set parentSlug = currentCategory.parent_slug|default('') %}
      {% if parentSlug %}
        {% set currentCategory = categories|filter(item => item.slug == parentSlug)|first|default(null) %}
        {% if not currentCategory %}{% set categoryPathValid = false %}{% set categoryTrail = [] %}{% endif %}
      {% else %}{% set currentCategory = null %}{% endif %}
    {% else %}
      {% if currentCategory and currentCategory.slug|default('') and currentCategory.slug in categoryTrail|map(item => item.slug) %}{% set categoryPathValid = false %}{% set categoryTrail = [] %}{% endif %}
      {% set currentCategory = null %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set categoryTrail = categoryTrail|reverse %}
{% set canonicalParts = meta.canonical|default('')|split('/') %}
{% set canonicalOrigin = canonicalParts|length >= 3 ? canonicalParts|slice(0, 3)|join('/') : '' %}
{% set graphs = jsonLd is iterable ? jsonLd : (jsonLd|default('') ? [jsonLd] : []) %}
{% set sourceBreadcrumbGraph = graphs|last|default('') %}
{% set sourceBreadcrumbGraph = sourceBreadcrumbGraph|replace({'\\/': '/'}) %}
{% set sourceBreadcrumbChunks = sourceBreadcrumbGraph|split('"item":"') %}
{% set sourceHomeUrl = sourceBreadcrumbChunks[1]|default('')|split('"')|first|default('') %}
{% set sourceHomeParts = sourceHomeUrl|split('/') %}
{% set siteOrigin = sourceHomeParts|length >= 3 ? sourceHomeParts|slice(0, 3)|join('/') : canonicalOrigin %}
{% set productBreadcrumbs = [
  {name: 'Главная', url: siteOrigin ~ '/'},
  {name: 'Каталог', url: siteOrigin ~ '/catalog'}
] %}
{% if page == 'product' and categoryPathValid and categoryTrail %}
  {% for category in categoryTrail %}
    {% set productBreadcrumbs = productBreadcrumbs|merge([{name: category.title, url: siteOrigin ~ '/category/' ~ (category.slug|url_encode)}]) %}
  {% endfor %}
{% endif %}
{% if page == 'product' and categoryPathValid and categoryTrail %}{% set productBreadcrumbs = productBreadcrumbs|merge([{name: product.sku|default(''), url: meta.canonical|default('')}]) %}{% endif %}
{% set headerNav = navigation.header ?? navigation|default([])|filter(item => item.location|default('') == 'header') %}
{% set footerNav = navigation.footer ?? navigation|default([])|filter(item => item.location|default('') == 'footer') %}
{% set legalNav = navigation.legal ?? navigation|default([])|filter(item => item.location|default('') == 'legal') %}
{% set home = model.home ?? (page == 'home' ? model.content|default({}) : {}) %}
{% set company = site.company_name|default('') %}
{% set digits = site.phone|default('')|replace({' ': '', '+': '', '(': '', ')': '', '-': '', '.': '', ' ': '', ' ': ''}) %}
{% set tel = digits matches '/^[0-9]+$/' ? 'tel:' ~ (site.phone starts with '+' ? '+' : '') ~ digits : '' %}
{% set callIconPath = 'M5 3.5h3.2l1.6 4.2-2 1.7a15 15 0 0 0 6.8 6.8l1.7-2 4.2 1.6V19c0 1.1-.9 2-2 2C10 21 3 14 3 5.5c0-1.1.9-2 2-2Z' %}
{% set emailIconPath = 'M3.5 5.5h17v13h-17zM4 7l8 6 8-6' %}
{% set title = meta.title|default(company) %}
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · V2</title>
  {% if site.yandex_verification|default('') %}<meta name="yandex-verification" content="{{ site.yandex_verification }}">{% endif %}
  {% if site.google_site_verification|default('') %}<meta name="google-site-verification" content="{{ site.google_site_verification }}">{% endif %}
  {% if site.yandex_metrika_id|default('') or site.google_analytics_id|default('') %}<script defer src="{{ assets }}analytics.js?v=20261112-1" data-yandex-metrika-id="{{ site.yandex_metrika_id }}" data-google-analytics-id="{{ site.google_analytics_id }}"></script>{% endif %}
  {% if meta.description|default('') %}<meta name="description" content="{{ meta.description }}">{% endif %}
  {% if meta.canonical|default('') %}<link rel="canonical" href="{{ meta.canonical }}"><meta property="og:url" content="{{ meta.canonical }}">{% endif %}
  {% if meta.robots|default('') %}<meta name="robots" content="{{ meta.robots }}">{% endif %}
  <meta property="og:title" content="{{ title }}">
  <meta property="og:type" content="{{ page == 'article' ? 'article' : 'website' }}">
  {% if meta.description|default('') %}<meta property="og:description" content="{{ meta.description }}">{% endif %}
  {% if meta.image|default('') %}<meta property="og:image" content="{{ meta.image }}">{% endif %}
  <link rel="stylesheet" href="{{ assets }}theme.css?v=20261111-1">
  <link rel="stylesheet" href="{{ assets }}globals.css?v=20261111-1">
  <link rel="stylesheet" href="{{ assets }}home-ux.css?v=20261111-1">
  <link rel="stylesheet" href="{{ assets }}catalog-ux.css?v=20261111-1">
  <link rel="stylesheet" href="{{ assets }}request-ux.css?v=20261111-1">
  <link rel="stylesheet" href="{{ assets }}articles.css?v=20261111-1">
  <link rel="stylesheet" href="{{ assets }}responsive-ux.css?v=20261111-1">
  <link rel="stylesheet" href="{{ assets }}storefront.css?v=20261111-1">
  <link rel="stylesheet" href="{{ assets }}v2-search/design.css?v=20261120-9">
  <script type="module" src="{{ assets }}v2-search/parallax.mjs?v=20261118-1"></script>
  <script type="module" src="{{ assets }}storefront.mjs?v=20261118-1"></script>
  <script type="module" src="{{ assets }}request.mjs?v=20261120-2"></script>
  <script type="module" src="{{ assets }}parts-list.mjs?v=20261118-1"></script>
  <script type="module" src="{{ assets }}v2-search/catalog-menu.mjs?v=20261119-1"></script>
  {% if page in ['home', 'catalog', 'product', 'parts-list', 'brands', 'brand', 'category', 'articles', 'article', 'page', 'request'] %}<script type="module" src="{{ assets }}v2-search/navigation.mjs?v=20261120-8"></script>{% endif %}
  {% for graph in graphs %}{% if not (page == 'product' and categoryPathValid and categoryTrail and graph matches '/"@type":"BreadcrumbList"/') %}<script type="application/ld+json">{{ graph|raw }}</script>{% endif %}{% endfor %}
  {% if page == 'product' and categoryPathValid and categoryTrail %}<script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: productBreadcrumbs|map((crumb, index) => {'@type': 'ListItem', position: index + 1, name: crumb.name, item: crumb.url})}|json_encode(constant('JSON_HEX_TAG') + constant('JSON_HEX_AMP') + constant('JSON_HEX_APOS') + constant('JSON_HEX_QUOT') + constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>{% endif %}
</head>
<body class="v2-storefront v2-{{ page }}" data-v2-page="{{ page }}">
  <a class="skip-link" href="#main-content" tabindex="0">К основному содержимому</a>
  {% include templates ~ 'v2/header.twig' %}
  <div class="v2-stage">
    {% if page in ['home', 'catalog', 'product', 'parts-list', 'brands', 'brand', 'category', 'articles', 'article', 'page', 'request'] %}<div class="v2-excavator-layer" aria-hidden="true"><img class="v2-excavator" src="{{ assets }}v2-search/images/excavator-drawing.webp?v=20261116-2" alt="" width="1536" height="1024" decoding="async"></div>{% endif %}
    <div id="v2-search-dock" class="shell v2-inner-search"{% if page == 'home' %} hidden{% endif %}>{% if page != 'home' %}{% include templates ~ 'v2/search.twig' %}{% endif %}</div>
    <div id="v2-navigation-status" class="v2-navigation-status" role="status" aria-live="polite" hidden></div>
    <main id="main-content" tabindex="-1"{% if page == 'catalog' and model.total|default(0) == 1 and not model.partial|default(false) and model.products|default([])|length == 1 %} data-v2-single-result="/product/{{ (model.products|first).slug|url_encode }}"{% endif %}>
    {% include templates ~ (page == 'home' ? 'v2/home' : screens[page]|default('error')) ~ '.twig' %}
    </main>
  </div>
  {% include templates ~ 'v2/footer.twig' %}
  <nav class="mobile-actions" aria-label="Связаться с компанией">
    <a class="mobile-action mobile-action-call" href="{{ tel ?: '/contacts' }}" aria-label="{{ tel ? 'Позвонить' : 'Контакты' }}">
      <svg class="mobile-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="{{ callIconPath }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ tel ? 'Позвонить' : 'Контакты' }}</span>
    </a>
    <a class="mobile-action mobile-action-request" href="/contacts" data-open-quick>
      <svg class="mobile-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="{{ emailIconPath }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Запрос</span>
    </a>
  </nav>
  <dialog class="quick-dialog" aria-labelledby="quick-dialog-title" data-quick-dialog>
    <button class="quick-dialog-close" type="button" data-close-quick aria-label="Закрыть форму"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    {% include templates ~ 'lead-form.twig' with {leadType: 'quick', compact: true, showQuickProduct: true} %}
    <a class="quick-fallback" href="/contacts">Связаться через страницу контактов</a>
  </dialog>
</body>
</html>
{% endautoescape %}
