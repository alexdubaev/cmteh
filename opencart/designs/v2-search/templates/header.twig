{% autoescape 'html' %}
{% import templates ~ 'ui.twig' as ui %}
<header class="site-header v2-header" id="site-header" tabindex="-1">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="{{ company ? company ~ ' — главная' : 'Главная' }}">{% if site.logo_url|default('') %}<img class="brand-logo" src="{{ site.logo_url }}" alt="" width="160" height="62">{% else %}{{ company|default('Главная') }}{% endif %}</a>
    <div class="v2-header-links">
      <details class="catalog-menu">
        <summary>Каталог <svg class="v2-catalog-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
        <div class="catalog-menu-panel">
          <div class="v2-catalog-tabs" role="tablist" aria-label="Раздел каталога" hidden>
            <span class="v2-catalog-indicator" aria-hidden="true"></span>
            <button type="button" role="tab" id="v2-tab-categories" aria-controls="v2-panel-categories" aria-selected="true">Категории</button>
            <button type="button" role="tab" id="v2-tab-brands" aria-controls="v2-panel-brands" aria-selected="false" tabindex="-1">Бренды</button>
          </div>
          <div class="v2-catalog-viewport">
            <section class="v2-catalog-group" id="v2-panel-categories"><strong class="v2-catalog-group-title">Категории</strong><div class="v2-catalog-links"><a href="/catalog">Все товары</a>{% for category in categories %}<a href="/category/{{ category.slug|url_encode }}">{% if category.parent_slug|default('') %}<span aria-hidden="true">↳ </span>{% endif %}{{ category.title }}</a>{% endfor %}</div></section>
            <section class="v2-catalog-group" id="v2-panel-brands"><strong class="v2-catalog-group-title">Бренды</strong><div class="v2-catalog-links"><a href="/brands">Все бренды</a>{% for brand in brands %}<a href="/brand/{{ brand.slug|url_encode }}">{{ brand.name }}</a>{% endfor %}</div></section>
          </div>
        </div>
      </details>
      <a href="/brands">Бренды</a>
    </div>
    <div class="header-actions">
      <a class="v2-list-top" href="/parts-list">Отправить список</a>
      <a class="request-link" href="/request" aria-label="Корзина" data-cart-link="Корзина"><img class="request-icon" src="{{ assets }}images/cart-icon-black.webp" alt="" width="20" height="20" aria-hidden="true"><span class="request-label">Корзина</span><b data-cart-count hidden></b></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Открыть меню"><img src="{{ assets }}v2-search/images/menu.svg" alt="" width="22" height="22"></button>
    </div>
  </div>
  <nav id="main-navigation" class="main-nav" aria-label="Основная навигация"><div class="shell main-nav-inner">{% for item in headerNav %}{{ ui.nav(item) }}{% endfor %}{% if tel %}<a href="{{ tel }}">{{ site.phone }}</a>{% endif %}{% if site.email|default('') %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}<a href="/contacts" data-open-quick>Быстрый запрос</a></div></nav>
</header>
{% endautoescape %}
