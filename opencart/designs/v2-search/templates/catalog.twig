{% macro categoryRows(items, params, parents) %}
  {% autoescape 'html' %}
  {% import 'extension/cmteh/catalog/view/template/storefront/ui.twig' as ui %}
  <ul class="v2-category-level">
    {% for category in items %}
      <li><a href="{{ ui.catalogHref(params, {category: category.slug}) }}"{% if category.slug in parents %} class="v2-category-branch"{% endif %}>{{ category.title }}</a></li>
    {% endfor %}
  </ul>
  {% endautoescape %}
{% endmacro %}
{% autoescape 'html' %}
{% import templates ~ 'ui.twig' as ui %}
{% set products = model.products|default([]) %}
{% set landing = model.landing|default({}) %}
{% set currentPage = model.page|default(1) %}
{% set maxPage = max(1, (model.total|default(0) / model.limit|default(12))|round(0, 'ceil')) %}
{% set availability = {'in_stock': 'В наличии', 'on_request': 'Под заказ', 'out_of_stock': 'Нет в наличии'} %}
{% set types = {'original': 'Оригинал', 'oem': 'OEM', 'analog': 'Аналог'} %}
{% set sorts = {'popular': 'По умолчанию', 'price_asc': 'Сначала дешевле', 'price_desc': 'Сначала дороже', 'title': 'По названию'} %}
{% set filterBrand = brands|filter(item => item.slug == params.brand|default(''))|first %}
{% set filterCategory = categories|filter(item => item.slug == params.category|default(''))|first %}
{% set filters = {
  q: params.q|default('') ? 'Поиск: ' ~ params.q : '',
  brand: params.brand|default('') ? 'Бренд: ' ~ filterBrand.name|default(params.brand) : '',
  category: params.category|default('') ? 'Категория: ' ~ filterCategory.title|default(params.category) : '',
  availability: params.availability|default('') ? 'Наличие: ' ~ availability[params.availability]|default(params.availability) : '',
  partType: params.partType|default('') ? 'Тип: ' ~ types[params.partType]|default(params.partType) : ''
}|filter(label => label is not empty) %}
<div class="shell page-shell">
  <div class="breadcrumbs catalog-breadcrumbs"><a href="/">Главная</a><span>/</span><span>{{ landing.title|default('Каталог') }}</span></div>
  <div class="catalog-layout">
    <div class="catalog-heading-row">
      <div class="catalog-head"><h1>{{ landing.h1|default(landing.title|default('Каталог')) }}</h1></div>
      <div class="catalog-controls">
        <div class="catalog-toolbar">
          <span>Найдено: <strong>{{ model.total|default(products|length) }}</strong></span>
          {% if model.partial|default(false) %}<span class="catalog-partial" role="status">Часть совпадений не проверена.</span>{% endif %}
          <div class="catalog-toolbar-right">
            <form action="/catalog" method="get">
              {% for key in ['q', 'brand', 'category', 'availability', 'partType'] %}{% if params[key]|default('') %}<input type="hidden" name="{{ key }}" value="{{ params[key] }}">{% endif %}{% endfor %}
              <select name="sort" aria-label="Сортировка">
                {% for key, label in sorts %}<option value="{{ key }}"{% if key == params.sort|default('popular') %} selected{% endif %}>{{ label }}</option>{% endfor %}
              </select>
              <button class="sort-apply" type="submit">Применить</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <details class="filter-disclosure v2-catalog-sidebar" open><summary>Фильтры и категории{% if filters %} · {{ filters|length }}{% endif %}</summary>
      <aside class="filters panel" aria-label="Фильтры и категории">
        {% if categories %}
          {% set selectedSlug = filterCategory.slug|default('') %}
          {% set parentSlug = filterCategory.parent_slug|default('') %}
          {% set parentCategory = categories|filter(item => item.slug == parentSlug)|first %}
          {% set branchSlugs = categories|map(item => item.parent_slug|default('')) %}
          {% set children = selectedSlug ? categories|filter(item => item.parent_slug|default('') == selectedSlug) : [] %}
          {% set levelSlug = children ? selectedSlug : parentSlug %}
          {% set level = children ?: categories|filter(item => item.parent_slug|default('') == levelSlug) %}
          {% if selectedSlug %}
            {% set level = level|filter(item => item.slug != selectedSlug) %}
          {% else %}
            {% set shortcuts = ['engine', 'hydraulics', 'undercarriage', 'transmission', 'filters'] %}
            {% set firstLevel = [] %}
            {% for slug in shortcuts %}
              {% set shortcut = level|filter(item => item.slug == slug)|first %}
              {% if shortcut %}{% set firstLevel = firstLevel|merge([shortcut]) %}{% endif %}
            {% endfor %}
            {% set level = firstLevel|merge(level|filter(item => item.slug not in shortcuts)) %}
          {% endif %}
          <nav class="v2-sidebar-section v2-category-nav" aria-labelledby="catalog-category-title">
            <h2 id="catalog-category-title">Категории</h2>
            {% if selectedSlug %}
              <a class="v2-category-back" href="{{ ui.catalogHref(params, {category: ''}) }}">Все категории</a>
              {% if parentCategory %}
                <a class="v2-category-back v2-category-up" href="{{ ui.catalogHref(params, {category: parentSlug}) }}" rel="up"><span aria-hidden="true">‹</span> {{ parentCategory.title }}</a>
              {% endif %}
              <p class="v2-category-current" aria-current="true">{{ filterCategory.title }}</p>
            {% endif %}
            {{ _self.categoryRows(level|slice(0, 5), params, branchSlugs) }}
            {% if level|length > 5 %}
              <details class="v2-category-more">
                <summary><span class="v2-more-show">Ещё категории</span><span class="v2-more-hide">Свернуть список</span><span class="v2-more-count" aria-hidden="true">{{ level|length - 5 }}</span></summary>
                {{ _self.categoryRows(level|slice(5), params, branchSlugs) }}
              </details>
            {% endif %}
          </nav>
        {% endif %}

        <section class="v2-sidebar-section" aria-labelledby="catalog-filters-title">
          <h2 id="catalog-filters-title">Фильтры</h2>
          {% if filters %}
            <div class="active-filters" aria-label="Активные фильтры">
              {% for key, label in filters %}<a href="{{ ui.catalogHref(params, {(key): ''}) }}" aria-label="Снять фильтр: {{ label }}">{{ label }} <b aria-hidden="true">×</b></a>{% endfor %}
            </div>
          {% endif %}
          <form class="facet-form" action="/catalog" method="get">
            {% for key in ['q', 'category', 'sort'] %}{% if params[key]|default('') %}<input type="hidden" name="{{ key }}" value="{{ params[key] }}">{% endif %}{% endfor %}
            <label>Бренд<select name="brand"><option value="">Все бренды</option>
              {% for brand in brands %}<option value="{{ brand.slug }}"{% if brand.slug == params.brand|default('') %} selected{% endif %}>{{ brand.name }}</option>{% endfor %}
            </select></label>
            <label>Наличие<select name="availability"><option value="">Любое</option>
              {% for key, label in availability %}<option value="{{ key }}"{% if key == params.availability|default('') %} selected{% endif %}>{{ label }}</option>{% endfor %}
            </select></label>
            <label>Тип<select name="partType" aria-label="Тип запчасти"><option value="">Любой</option>
              {% for key, label in types %}<option value="{{ key }}"{% if key == params.partType|default('') %} selected{% endif %}>{{ label }}</option>{% endfor %}
            </select></label>
            <button class="button primary wide" type="submit">Применить фильтры</button>
            {% if filters or params.sort|default('') %}<a class="reset-filters" href="/catalog">Сбросить все фильтры</a>{% endif %}
          </form>
        </section>
      </aside>
    </details>
    <section class="catalog-content">
      {% set query = params.q|default('')|trim %}
      {% if query and (query|length < 2 or query|length > 64) %}
        <div class="panel empty-state"><h2>Проверьте поисковый запрос</h2><p role="status">{{ query|length < 2 ? 'Поисковый запрос должен содержать не менее 2 символов.' : 'Сократите поисковый запрос до 64 символов.' }}</p></div>
      {% elseif products %}
        <div class="product-grid catalog-grid">{% for product in products %}{{ ui.card(product) }}{% endfor %}</div>
      {% else %}
        <div class="panel empty-state"><h2>Ничего не найдено</h2><p>Проверьте артикул или измените фильтры. Вы также можете передать артикул для подбора в заявке.</p>
          <a class="button primary" href="/parts-list{% if query %}?article={{ query|url_encode }}{% endif %}">{{ query ? 'Передать артикул для подбора' : 'Передать список для подбора' }}</a>
        </div>
      {% endif %}
      {% if maxPage > 1 %}
      {% set pageNumbers = maxPage <= 7 ? range(1, maxPage) : [1, currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2, maxPage]|filter(number => number >= 1 and number <= maxPage)|reduce((all, number) => number in all ? all : all|merge([number]), [])|sort %}
      <nav class="pagination" aria-label="Пагинация">
        {% if currentPage > 1 %}<a aria-label="Предыдущая страница" href="{{ ui.catalogHref(params, {page: currentPage - 1}) }}">←</a>{% endif %}
        {% for number in pageNumbers %}
          <span class="pagination-slot">
            {% if not loop.first and pageNumbers[loop.index0 - 1] < number - 1 %}<span class="ellipsis">…</span>{% endif %}
            <a class="{{ number == currentPage ? 'active' : '' }}"{% if number == currentPage %} aria-current="page"{% endif %} href="{{ ui.catalogHref(params, {page: number}) }}">{{ number }}</a>
          </span>
        {% endfor %}
        {% if currentPage < maxPage %}<a aria-label="Следующая страница" href="{{ ui.catalogHref(params, {page: currentPage + 1}) }}">→</a>{% endif %}
      </nav>{% endif %}
    </section>
  </div>
  {% if landing.intro|default('') %}<details class="collection-about panel"><summary>О каталоге</summary><p>{{ landing.intro }}</p></details>{% endif %}
  {% include templates ~ 'editorial.twig' with {content: landing} %}
</div>
{% endautoescape %}
